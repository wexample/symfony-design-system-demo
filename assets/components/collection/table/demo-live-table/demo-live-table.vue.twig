{%- extends '@WexampleSymfonyDesignSystemBundle/components/collection/table/abstract-entity-table/abstract-entity-table.vue.twig' -%}

{%- block vue_body -%}
    <div class="demo-live">
        <div class="toolbar toolbar--shaded toolbar--compact">
            <span class="text-secondary">
                [[ watch ]] · [[ readCount ]] read[[ readCount === 1 ? '' : 's' ]]
            </span>
            <div class="toolbar--group">
                <button
                        v-if="watch === 'events'"
                        type="button"
                        class="button"
                        @click="ringRefreshEvent"
                >Ring the event</button>
                <button
                        v-if="watch === 'live'"
                        type="button"
                        class="button"
                        @click="simulateLiveMessage"
                >Publish a message</button>
                <button type="button" class="button" @click="refreshEntitiesCollection">Read now</button>
            </div>
        </div>
        {{ parent() }}
    </div>
{%- endblock -%}
