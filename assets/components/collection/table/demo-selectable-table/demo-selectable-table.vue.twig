{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/data-table') -}}
{%- endblock -%}

{%- block vue_body -%}
    <div class="demo-selectable-table">
        <data-table
                :rows="rows"
                :columns="columns"
                :app="app"
                :show-header="true"
                :row-key="getRowKey"
                :selectable="true"
                v-model:selected="selected"
                :bulk-actions="bulkActions"
                :bulk-actions-mode="mode"
                :show-count="true"
                :filters="filters"
                :filter-rows="true"
                :default-sort="defaultSort"
                v-model:sort="sort"
                :sort-rows="true"
                :page-size="3"
                @bulk-action="onBulkAction"
                :error="error"
                @retry="retry"
        ></data-table>
        <button v-if="!error" class="button button--flat button--compact demo-selectable-table--fail" type="button" @click="failRead">Simulate a failed read</button>
        <p class="text-secondary">[[ lastAction || selected.join(', ') || '—' ]] · [[ (sort || defaultSort).key ]] [[ (sort || defaultSort).direction ]]</p>
    </div>
{%- endblock -%}
