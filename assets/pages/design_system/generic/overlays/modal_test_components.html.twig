{%- extends '@WexampleSymfonyDesignSystemDemoBundle/layouts/design_system/layout.html.twig' -%}

{%- block page_body -%}
    <div class="block block--padded block--vertical">
        <div class="lead">
            {{ '@page::intro' | trans }}
        </div>
        <div class="stack--horizontal">
            {% set menu_items = [
                {
                    icon: 'ph:bold/clipboard-text',
                    label: '@page::menu.item.report',
                    href: app_home_url()
                },
                {
                    icon: 'ph:bold/gear',
                    label: '@page::menu.item.settings',
                    href: app_home_url()
                },
                {
                    icon: 'ph:bold/sign-out',
                    label: '@page::menu.item.logout',
                    href: app_home_url()
                }
            ] %}
            {{ button_menu('ph:bold/list', '@page::menu.label' | trans, menu_items) }}
            {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/upload-handler', {
                slots: {
                    button: button('ph:bold/upload-simple', '@page::upload_button' | trans)
                }
            }) }}
        </div>
        {#- A field that opens an overlay of its own, from inside one: the
            backdrop must stay under the modal, or it covers the very select it
            was opened from. -#}
        {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/select', {}, {
            options: [
                { value: 'one',   label: '@page::choice.one' },
                { value: 'two',   label: '@page::choice.two' },
                { value: 'three', label: '@page::choice.three' }
            ],
            value: 'one'
        }) }}
        {{ button('ph:bold/bell', '@page::toast_button' | trans, {
            class: 'modal-components-toast-button',
            attr: {
                'data-toast-title': '@page::toast_title' | trans,
                'data-toast-message': '@page::toast_message' | trans
            }
        }) }}
    </div>
{%- endblock -%}
