{%- extends '@WexampleSymfonyDesignSystemDemoBundle/layouts/design_system/layout.html.twig' -%}

{%- set page_show_title = true -%}

{%- block page_body -%}
    {#- Nothing on this page is written down: it draws the registries the bundles
        ship, each generated from a walk of its own assets. The page is a consumer
        of those files like any other, so a registry nobody regenerated is a page
        that says which bundle it is missing rather than a page showing fewer rows
        than it should. -#}
    {%- set inventory = ds_element_registry() -%}
    {%- set missing = ds_element_registry_missing() -%}

    {%- if missing is not empty -%}
        {{ message_error('@page::missing.title' | trans, '@page::missing.body' | trans({
            '%bundles%': missing|join(', '),
            '%command%': 'design-system:generate-element-registry'
        })) }}
    {%- endif -%}
    {%- set formats = inventory.formatValues -%}
    {%- set by_format = inventory.countByFormat -%}
    {%- set by_stance = inventory.countByStance -%}

    <p class="lead">{{ '@page::intro' | trans }}</p>

    {#- The summary is the same table as the matrix below it, at another scale:
        one row per thing counted, the number right-aligned. -#}
    {{ data_table(
        [
            { key: 'label', label: '@page::summary.label' | trans },
            { key: 'count', label: '@page::summary.count' | trans, align: 'right' }
        ],
        [
            { label: '@page::summary.elements' | trans, count: inventory.countEntries },
            { label: '@page::summary.todo' | trans, count: by_stance.todo },
            { label: '@page::summary.undecided' | trans, count: by_stance.undecided },
            { label: '@page::summary.shapes' | trans, count: inventory.shapes|length },
            { label: '@page::summary.abstracts' | trans, count: inventory.abstracts|length }
        ]|merge(
            formats|map(format => {
                label: ('@page::format.' ~ format ~ '.title') | trans,
                count: by_format[format]
            })
        )
    ) }}

    <h2>{{ '@page::section.matrix.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.matrix.description' | trans }}</div>

    {#- The matrix is the table helper, and nothing of its own: a group row per
        bundle, a status cell per format, a sticky header for a table this long.
        What is read on a row is decided here, drawn nowhere. -#}
    {%- set shared = inventory.findSharedKeys -%}
    {%- set columns = [{ key: 'element', label: '@page::column.element' | trans, cell: 'html' }] -%}
    {%- for format in formats -%}
        {%- set columns = columns|merge([{
            key: format,
            label: ('@page::format.' ~ format ~ '.title') | trans,
            cell: 'status',
            align: 'center'
        }]) -%}
    {%- endfor -%}

    {%- set rows = [] -%}
    {%- for source, source_entries in inventory.entriesBySource -%}
        {%- set rows = rows|merge([{ group: '@' ~ source }]) -%}
        {%- for entry in source_entries -%}
            {#- Every declared element reads at the same level. One format and no
                other may be a gap or a deliberate exception, and the table is
                what the sorting out will be done on — not its verdict. -#}
            {%- set element -%}
                {%- if entry.group -%}<span class="text-secondary">{{ entry.group }}/</span>{%- endif -%}
                <code>{{ entry.shortName }}</code>
                {%- if shared[entry.key] is defined -%}
                    {#- Not a fault: the loader tells them apart. The one thing a
                        reader of the union would want pointed at. -#}
                    <span class="pill" title="{{ '@page::cell.shared' | trans({ '%bundles%': shared[entry.key]|join(', ') }) }}">{{ shared[entry.key]|length }}</span>
                {%- endif -%}
            {%- endset -%}
            {%- set row = { element: element } -%}
            {%- for format, occurrences in entry.occurrences -%}
                {%- set stance = entry.stances[format] ?? 'undecided' -%}
                {%- set note = entry.notes[format] ?? null -%}
                {%- if occurrences is not empty -%}
                    {%- set cell = { type: 'success', count: occurrences|length > 1 ? occurrences|length : null, title: occurrences|join(', ') } -%}
                {%- elseif stance == 'todo' -%}
                    {#- Wanted and missing: work someone can pick up, which is
                        the whole difference with the blank beside it. -#}
                    {%- set cell = { type: 'warning', title: note ?? '@page::cell.todo' | trans } -%}
                {%- elseif stance == 'waived' -%}
                    {%- set cell = { type: 'disabled', title: note } -%}
                {%- else -%}
                    {#- Not found and nothing said about it: a decision not yet
                        made, which no state honestly stands for. -#}
                    {%- set cell = null -%}
                {%- endif -%}
                {%- set row = row|merge({ (format): cell }) -%}
            {%- endfor -%}
            {%- set rows = rows|merge([row]) -%}
        {%- endfor -%}
    {%- endfor -%}

    {{ data_table(columns, rows, { sticky: true }) }}

    <h2>{{ '@page::section.abstract.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.abstract.description' | trans }}</div>

    {#- The formats they do carry, and nothing about the ones they do not: what
        someone extending a base wants to know is what it already brings. -#}
    {{ data_table(
        [{ key: 'element', label: '@page::column.element' | trans, cell: 'html' }]|merge(
            formats|map(format => {
                key: format,
                label: ('@page::format.' ~ format ~ '.title') | trans,
                cell: 'status',
                align: 'center'
            })
        ),
        inventory.abstracts|map(entry => {
            element: '<code title="' ~ entry.source ~ '">' ~ entry.key ~ '</code>'
        }|merge(
            formats|reduce((carry, format) => carry|merge({
                (format): entry.occurrences[format] is not empty
                    ? { type: 'success', title: entry.occurrences[format]|join(', ') }
                    : null
            }), {})
        ))
    ) }}

    <h2>{{ '@page::section.shapes.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.shapes.description' | trans }}</div>

    {#- Two columns and no third: a shape has no renderer, so a table of
        renderers has nothing to offer it. What is worth knowing is its name and
        what it is for, and both are read off the stylesheet itself. -#}
    {{ data_table(
        [
            { key: 'shape', label: '@page::column.shape' | trans, cell: 'html' },
            { key: 'description', label: '@page::column.description' | trans }
        ],
        inventory.shapes|map(shape => {
            shape: '<code title="' ~ shape.path ~ '">' ~ shape.key ~ '</code>',
            description: shape.description
        })
    ) }}

    <h2>{{ '@page::section.coverage.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.coverage.description' | trans }}</div>
    <div class="block block--padded">
        <div class="cluster">
            {%- for path in inventory.unscannedPaths -%}
                <code class="pill">{{ path }}</code>
            {%- endfor -%}
        </div>
    </div>

    <h2>{{ '@page::section.sources.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.sources.description' | trans }}</div>
    <div class="block block--padded">
        <div class="cluster">
            {%- for alias in ds_element_registry_sources() -%}
                <code class="pill">@{{ alias }}</code>
            {%- endfor -%}
        </div>
    </div>
{%- endblock -%}
