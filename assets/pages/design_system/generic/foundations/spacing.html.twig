{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/foundations/layout/layout-foundations.html.twig' -%}

{%- macro step(token, label) -%}
    <div class="metric">
        <code class="metric--token">{{ token }}</code>
        <div class="metric--sample" style="width: var({{ token }});"></div>
        {%- if label %}<span class="metric--note">{{ label }}</span>{% endif -%}
    </div>
{%- endmacro -%}

{%- block page_body -%}
    {% import _self as scale %}

    <p class="lead">{{ '@page::intro' | trans }}</p>

    <h2>{{ '@page::section.space.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.space.description' | trans }}</div>
    <div class="block block--padded block--vertical">
        {%- for i in 1..9 -%}
            {{ scale.step('--space-' ~ i, null) }}
        {%- endfor -%}
    </div>

    <h2>{{ '@page::section.size.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.size.description' | trans }}</div>
    <div class="block block--padded block--vertical">
        {%- for i in 1..6 -%}
            {{ scale.step('--size-' ~ i, null) }}
        {%- endfor -%}
    </div>

    <h2>{{ '@page::section.radius.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.radius.description' | trans }}</div>
    <div class="block block--padded">
        <div class="cluster">
            {%- for token in ['--radius-1', '--radius-2', '--radius-pill'] -%}
                <div class="radius-sample" style="border-radius: var({{ token }});">
                    <code>{{ token }}</code>
                </div>
            {%- endfor -%}
        </div>
    </div>

    <h2>{{ '@page::section.density.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.density.description' | trans }}</div>
    <div class="block block--padded block--vertical flow">
        <div>
            <p class="text-secondary">{{ '@page::density.roomy' | trans }}</p>
            <div class="toolbar toolbar--shaded">
                {{ button('ph:bold/plus', '@page::density.action' | trans) }}
                {{ button('ph:bold/arrows-clockwise', '@page::density.other' | trans) }}
            </div>
        </div>
        <div>
            <p class="text-secondary">{{ '@page::density.compact' | trans }}</p>
            {#- Nothing is said about the buttons: the bar declares the region
                compact and they read it. -#}
            <div class="toolbar toolbar--shaded toolbar--compact">
                {{ button('ph:bold/plus', '@page::density.action' | trans) }}
                {{ button('ph:bold/arrows-clockwise', '@page::density.other' | trans) }}
            </div>
        </div>
        <div>
            <p class="text-secondary">{{ '@page::density.marker' | trans }}</p>
            <div class="is-compact cluster">
                {{ button('ph:bold/plus', '@page::density.action' | trans) }}
                {{ button('ph:bold/arrows-clockwise', '@page::density.other' | trans) }}
            </div>
        </div>
    </div>
{%- endblock -%}
