{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/foundations/layout/layout-foundations.html.twig' -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    <h2>{{ '@page::section.radius.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.radius.description' | trans }}</div>
    <div class="block block--padded">
        <div class="cluster">
            {%- for token in ['--radius-0', '--radius-1', '--radius-2', '--radius-3', '--radius-pill'] -%}
                <div class="skin-sample" style="border-radius: var({{ token }});">
                    <code>{{ token }}</code>
                </div>
            {%- endfor -%}
        </div>
    </div>

    <h2>{{ '@page::section.role.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.role.description' | trans }}</div>
    <div class="block block--padded">
        <div class="cluster">
            {%- for role in ['control', 'field', 'surface', 'media', 'pill'] -%}
                <div class="skin-sample" style="border-radius: var(--radius-{{ role }});">
                    <div>
                        <code>--radius-{{ role }}</code>
                        <div class="text-secondary">{{ ('@page::role.' ~ role) | trans }}</div>
                    </div>
                </div>
            {%- endfor -%}
        </div>
    </div>

    <h2>{{ '@page::section.shadow.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.shadow.description' | trans }}</div>
    <div class="block block--padded">
        <div class="cluster skin-cluster--airy">
            {%- for i in 1..4 -%}
                <div class="skin-sample skin-sample--raised" style="box-shadow: var(--shadow-{{ i }});">
                    <code>--shadow-{{ i }}</code>
                </div>
            {%- endfor -%}
        </div>
    </div>

    <h2>{{ '@page::section.border.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.border.description' | trans }}</div>
    <div class="block block--padded">
        <div class="cluster">
            {%- for token in ['--border-discreet', '--border-default', '--border-focus', '--border-placeholder'] -%}
                <div class="skin-sample" style="border: var({{ token }});">
                    <code>{{ token }}</code>
                </div>
            {%- endfor -%}
        </div>
    </div>

    <h2>{{ '@page::section.separator.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.separator.description' | trans }}</div>
    <div class="block block--padded">
        <div class="stack--vertical stack--divided">
            <div><code>--border-separator</code> — {{ '@page::separator.row' | trans }}</div>
            <div>{{ '@page::separator.row' | trans }}</div>
            <div>{{ '@page::separator.row' | trans }}</div>
        </div>
    </div>
    <div class="zone zone--bordered zone--padded">
        <code>--border-region</code> — {{ '@page::separator.region' | trans }}
    </div>
{%- endblock -%}
