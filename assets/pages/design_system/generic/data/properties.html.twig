{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/data/layout/layout-data.html.twig' -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    <h2>{{ '@page::section.default.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.default.description' | trans }}</div>
    <div class="block block--padded">
        {{ properties([
            { key: '@page::field.name.key' | trans, value: '@page::field.name.value' | trans },
            { key: '@page::field.identifier.key' | trans, value: '@page::field.identifier.value' | trans },
            { key: '@page::field.description.key' | trans, value: '@page::field.description.value' | trans },
        ]) }}
    </div>

    <h2>{{ '@page::section.bordered.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.bordered.description' | trans }}</div>
    <div class="block">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/info') }}</span>
            <span class="block--title-label">{{ '@page::section.bordered.block_title' | trans }}</span>
        </div>
        <div class="block--body">
            {{ properties(
                [
                    {
                        key: '@page::field.status.key' | trans,
                        value: '<span class="pill">' ~ '@page::field.status.value' | trans ~ '</span>',
                        html: true,
                    },
                    { key: '@page::field.owner.key' | trans, value: '@page::field.owner.value' | trans },
                    { key: '@page::field.created.key' | trans, value: '@page::field.created.value' | trans },
                    { key: '@page::field.description.key' | trans, value: '@page::field.description.value' | trans },
                ],
                { bordered: true }
            ) }}
        </div>
    </div>

    <h2>{{ '@page::section.split.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.split.description' | trans }}</div>
    <div class="block block--padded">
        {{ properties(
            [
                { key: '@page::amount.subtotal.key' | trans, value: '@page::amount.subtotal.value' | trans },
                { key: '@page::amount.tax.key' | trans, value: '@page::amount.tax.value' | trans },
                { key: '@page::amount.total.key' | trans, value: '@page::amount.total.value' | trans },
            ],
            { bordered: true, split: true }
        ) }}
    </div>

    <h2>{{ '@page::section.compact.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.compact.description' | trans }}</div>
    <div class="block block--padded">
        {{ properties(
            [
                { key: '@page::field.region.key' | trans, value: '@page::field.region.value' | trans },
                { key: '@page::field.runtime.key' | trans, value: '@page::field.runtime.value' | trans },
                { key: '@page::field.version.key' | trans, value: '@page::field.version.value' | trans },
            ],
            { compact: true }
        ) }}
    </div>

    <h2>{{ '@page::section.stacked.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.stacked.description' | trans }}</div>
    <div class="zone zone--split zone--split--wrap zone--gap">
        <div class="zone zone--narrow zone--size-6">
            <div class="block block--padded">
                {{ properties(
                    [
                        { key: '@page::field.identifier.key' | trans, value: '@page::field.identifier.value' | trans },
                        { key: '@page::field.owner.key' | trans, value: '@page::field.owner.value' | trans },
                        { key: '@page::field.created.key' | trans, value: '@page::field.created.value' | trans },
                    ],
                    { stacked: true, bordered: true }
                ) }}
            </div>
        </div>
        <div class="zone">
            <div class="block block--padded">
                <p>{{ '@page::section.stacked.aside' | trans }}</p>
            </div>
        </div>
    </div>

    <h2>{{ '@page::section.columns.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.columns.description' | trans }}</div>
    {#- A field nobody filled says so with a dash, and the path takes the whole
        width rather than stretching every column to its length. -#}
    <div class="block block--padded">
        {{ properties(
            [
                { key: '@page::field.identifier.key' | trans, value: '@page::field.identifier.value' | trans },
                { key: '@page::field.owner.key' | trans,      value: '@page::field.owner.value' | trans },
                { key: '@page::field.created.key' | trans,    value: '@page::field.created.value' | trans },
                { key: '@page::field.region.key' | trans,     value: '@page::field.region.value' | trans },
                { key: '@page::field.runtime.key' | trans,    value: '@page::field.runtime.value' | trans },
                { key: '@page::field.version.key' | trans,    value: '@page::field.version.value' | trans },
                { key: '@page::field.reviewed.key' | trans,   value: null },
                { key: '@page::field.path.key' | trans, value: '@page::field.path.value' | trans, full: true }
            ],
            { columns: true }
        ) }}
    </div>

    <h2>{{ '@page::section.vue.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.vue.description' | trans }}</div>
    <div class="block block--padded">
        {{ vue(render_pass, '@WexampleSymfonyDesignSystemBundle/components/properties', {
            items: [
                { key: '@page::field.name.key' | trans, value: '@page::field.name.value' | trans },
                { key: '@page::field.identifier.key' | trans, value: '@page::field.identifier.value' | trans },
                { key: '@page::field.status.key' | trans, value: '@page::field.status.value' | trans },
            ],
            bordered: true,
            split: true
        }) }}
    </div>
{%- endblock -%}
