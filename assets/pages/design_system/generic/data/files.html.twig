{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/data/layout/layout-data.html.twig' -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    <h2>{{ '@page::section.vue.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.vue.description' | trans }}</div>
    {{ vue(render_pass, '@WexampleSymfonyDesignSystemDemoBundle/components/demo-file-explorer') }}

    {#- The server twin, walked through the page's query: `?folder=docs`. The
        folder's content is written here, as a controller would hand it. -#}
    {%- set folder = app.request.query.get('folder', '') -%}
    {%- set here = path(app.request.attributes.get('_route')) -%}
    {%- set tree = {
        '': [{ name: 'docs', type: 'directory' }, { name: 'README.md', type: 'file', size: 2400, modifiedAt: '2026-09-20 10:12' }, { name: 'composer.json', type: 'file', size: 1180, modifiedAt: '2026-09-22 16:40' }],
        'docs': [{ name: 'guide', type: 'directory' }, { name: 'architecture.md', type: 'file', size: 18200, modifiedAt: '2026-09-18 09:00' }, { name: 'logo.svg', type: 'file', size: 5400, modifiedAt: '2026-08-30 14:05' }],
        'docs/guide': [{ name: 'install.md', type: 'file', size: 3100, modifiedAt: '2026-09-01 11:30' }, { name: 'intro.mp4', type: 'file', size: 48234000, modifiedAt: '2026-07-14 18:22' }],
    } -%}
    {%- set listing = [] -%}
    {%- for item in tree[folder] ?? [] -%}
        {%- set item_path = folder ? folder ~ '/' ~ item.name : item.name -%}
        {%- set listing = listing|merge([item|merge({ href: item.type == 'directory' ? here ~ '?folder=' ~ item_path|url_encode : '#' })]) -%}
    {%- endfor -%}
    {%- set crumbs = [{ label: '@page::root' | trans, href: here }] -%}
    {%- set walked = '' -%}
    {%- for part in folder|split('/')|filter(part => part) -%}
        {%- set walked = walked ? walked ~ '/' ~ part : part -%}
        {%- set crumbs = crumbs|merge([{ label: part, href: here ~ '?folder=' ~ walked|url_encode }]) -%}
    {%- endfor -%}

    <h2>{{ '@page::section.twig.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.twig.description' | trans }}</div>
    <div class="cluster">
        {{ file_explorer(listing, crumbs) }}
        {{ file_explorer(listing, crumbs, { view: 'grid' }) }}
    </div>
{%- endblock -%}
