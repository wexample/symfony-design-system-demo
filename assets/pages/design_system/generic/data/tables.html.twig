{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/data/layout/layout-data.html.twig' -%}

{%- block page_body -%}
        {% set actions_columns = [
            { key: 'name', label: '@page::column.actions.name' | trans },
            { key: 'date', label: '@page::column.actions.date' | trans, secondary: true },
            { key: 'operations', label: '@page::column.actions.operations' | trans, cell: 'actions', class: 'table--cell--fit' },
        ] %}
        {#- The same two actions the Vue table below declares, so the pair can be
            compared on one page: a target sends the page to an overlay instead of
            replacing the current one. -#}
        {% set row_actions = [
            {
                icon: 'ph:bold/eye',
                href: path('wexample_design_system_generic_overlays_modal_test_simple'),
                target: 'modal',
                target_options: { closeOnEscape: true, closeOnOverlayClick: true }
            },
            {
                icon: 'ph:bold/pencil-simple',
                href: path('wexample_design_system_generic_overlays_modal_test_medium'),
                target: 'panel',
                target_options: { closeOnEscape: true, closeOnOverlayClick: true }
            },
        ] %}

        <section>
            <h2>{{ '@page::section.default.title' | trans }}</h2>
            {#- The third column is a date cell: the server prints the instant and
                the browser keeps counting from it, exactly as the vue table does. -#}
            {{ data_table(
                [
                    { key: 'name', label: '@page::column.default.name' | trans },
                    { key: 'date', label: '@page::column.default.date' | trans, secondary: true },
                    { key: 'seen', label: '@page::column.default.seen' | trans, cell: 'date', secondary: true },
                ],
                [
                    { name: '@page::row.one.title' | trans, date: '@page::row.one.meta' | trans, seen: '-40 seconds' },
                    { name: '@page::row.two.title' | trans, date: '@page::row.two.meta' | trans, seen: '-22 minutes' },
                    { name: '@page::row.three.title' | trans, date: '@page::row.three.meta' | trans, seen: '-3 hours' },
                ]
            ) }}
        </section>

        <section>
            <h2>{{ '@page::section.wide.title' | trans }}</h2>
            <div class="lead">{{ '@page::section.wide.description' | trans }}</div>
            {#- Twelve columns of words that will not wrap: wider than the page
                on any screen, so the frame has something to scroll. -#}
            {%- set wide_columns = [] -%}
            {%- set wide_row = {} -%}
            {%- for i in 1..12 -%}
                {%- set wide_columns = wide_columns|merge([{ key: 'c' ~ i, label: ('@page::column.wide' | trans) ~ ' ' ~ i }]) -%}
                {%- set wide_row = wide_row|merge({ ('c' ~ i): '@page::row.wide' | trans }) -%}
            {%- endfor -%}
            {{ data_table(wide_columns, [wide_row, wide_row, wide_row], { class: 'tables-demo--wide' }) }}
        </section>

        <section>
            <h2>{{ '@page::section.actions.title' | trans }}</h2>
            {{ data_table(
                actions_columns,
                [
                    { name: '@page::row.action.one.title' | trans, date: '@page::row.action.one.meta' | trans, operations: row_actions },
                    { name: '@page::row.action.two.title' | trans, date: '@page::row.action.two.meta' | trans, operations: row_actions },
                ]
            ) }}
        </section>

        <section>
            <h2>{{ '@page::section.links.title' | trans }}</h2>
            {{ data_table(
                [
                    { key: 'source', label: '@page::column.links.source' | trans, cell: 'link' },
                    { key: 'state', label: '@page::column.links.state' | trans, cell: 'icon', align: 'center' },
                ],
                [
                    { source: { label: '@page::row.action.one.title' | trans, href: '#' }, state: { icon: 'ph:bold/check-circle', href: '#' } },
                    { source: { label: '@page::row.action.two.title' | trans }, state: { icon: 'ph:bold/clock' } },
                ]
            ) }}
        </section>

        <section>
            <h2>{{ '@page::section.loading.title' | trans }}</h2>
            {{ data_table(actions_columns, [], {
                loading: true,
                loading_label: '@page::row.action.loading.label' | trans
            }) }}
        </section>

        <section>
            <h2>{{ '@page::section.empty.title' | trans }}</h2>
            {{ data_table(actions_columns, [], {
                empty_label: '@page::row.action.empty.label' | trans
            }) }}
        </section>

        <section>
            <h2>{{ '@page::section.alignment.title' | trans }}</h2>
            {{ data_table(
                [
                    { key: 'name', label: '@page::column.alignment.left' | trans },
                    { key: 'status', label: '@page::column.alignment.center' | trans, align: 'center' },
                    { key: 'amount', label: '@page::column.alignment.right' | trans, align: 'right' },
                ],
                [
                    { name: 'Alpha', status: 'Centered', amount: '42.00 €' },
                    { name: 'Beta', status: 'Centered', amount: '128.50 €' },
                    { name: 'Gamma', status: 'Centered', amount: '7.99 €' },
                ]
            ) }}
        </section>

        <section>
            <h2>{{ '@page::section.markdown.title' | trans }}</h2>
            <p>{{ '@page::section.markdown.description' | trans }}</p>
            {#- A pipe table as a document writes it: alignment in the rule under
                the header, markup inside the cells. -#}
            {%- set markdown_source -%}
| **Name** | Status | Amount |
|:---|:---:|---:|
| [Alpha](#) | `ready` | 42.00 € |
| Beta | ~~draft~~ | 128.50 € |
| Gamma | pending | 7.99 € |
            {%- endset -%}
            {{ markdown_source | markdown_ds }}
        </section>

        <section>
            <h2>{{ '@page::section.groups.title' | trans }}</h2>
            <p>{{ '@page::section.groups.description' | trans }}</p>
            {{ data_table(
                [
                    { key: 'name', label: '@page::column.default.name' | trans },
                    { key: 'date', label: '@page::column.default.date' | trans, secondary: true },
                ],
                [
                    { group: '@page::group.first' | trans },
                    { name: '@page::row.one.title' | trans, date: '@page::row.one.meta' | trans },
                    { name: '@page::row.two.title' | trans, date: '@page::row.two.meta' | trans },
                    { group: '@page::group.second' | trans },
                    { name: '@page::row.three.title' | trans, date: '@page::row.three.meta' | trans },
                ]
            ) }}
        </section>

        <section>
            <h2>{{ '@page::section.status.title' | trans }}</h2>
            <p>{{ '@page::section.status.description' | trans }}</p>
            {{ data_table(
                [
                    { key: 'name', label: '@page::column.status.name' | trans },
                    { key: 'build', label: '@page::column.status.build' | trans, cell: 'status', align: 'center' },
                    { key: 'tests', label: '@page::column.status.tests' | trans, cell: 'status', align: 'center' },
                    { key: 'deploy', label: '@page::column.status.deploy' | trans, cell: 'status', align: 'center' },
                ],
                [
                    { name: '@page::row.one.title' | trans, build: 'success', tests: { type: 'success', count: 42 }, deploy: 'pending' },
                    { name: '@page::row.two.title' | trans, build: 'success', tests: { type: 'warning', count: 3, title: '@page::status.flaky' | trans }, deploy: 'skipped' },
                    { name: '@page::row.three.title' | trans, build: 'error', tests: null, deploy: 'disabled' },
                ]
            ) }}
        </section>

        <section>
            <h2>{{ '@page::section.sticky.title' | trans }}</h2>
            <p>{{ '@page::section.sticky.description' | trans }}</p>
            {%- set long_rows = [] -%}
            {%- for i in 1..40 -%}
                {%- set long_rows = long_rows|merge([{ index: i, name: 'Row ' ~ i, state: i is divisible by(7) ? 'warning' : 'success' }]) -%}
            {%- endfor -%}
            {{ data_table(
                [
                    { key: 'index', label: '#', class: 'table--cell--fit' },
                    { key: 'name', label: '@page::column.default.name' | trans },
                    { key: 'state', label: '@page::column.links.state' | trans, cell: 'status', align: 'center' },
                ],
                long_rows,
                { sticky: true }
            ) }}
        </section>

        <section>
            <h2>{{ '@page::section.vue.title' | trans }}</h2>
            {{ vue_include(render_pass, '@WexampleSymfonyDesignSystemDemoBundle/components/collection/table/demo-entity-table') }}
        </section>

        <section>
            <h2>{{ '@page::section.vue_compact.title' | trans }}</h2>
            <p>{{ '@page::section.vue_compact.description' | trans }}</p>
            {{ vue_include(render_pass, '@WexampleSymfonyDesignSystemDemoBundle/components/collection/table/demo-compact-table') }}
        </section>

        <section>
            <h2>{{ '@page::section.vue_dates.title' | trans }}</h2>
            {{ vue_include(render_pass, '@WexampleSymfonyDesignSystemDemoBundle/components/collection/table/demo-dates-table') }}
        </section>
{%- endblock -%}
