{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/data/layout/layout-data.html.twig' -%}

{%- block page_body -%}
        {% set actions_columns = [
            { key: 'name', label: '@page::column.actions.name' | trans },
            { key: 'date', label: '@page::column.actions.date' | trans, secondary: true },
            { key: 'operations', label: '@page::column.actions.operations' | trans, cell: 'actions', class: 'table--cell--fit' },
        ] %}
        {#- The same two actions the Vue table below declares, so the pair can be
            compared on one page: a target sends the page to an overlay instead of
            replacing the current one. -#}
        {% set row_actions = [
            {
                icon: 'ph:bold/eye',
                href: path('wexample_design_system_generic_overlays_modal_test_simple'),
                target: 'modal',
                target_options: { closeOnEscape: true, closeOnOverlayClick: true }
            },
            {
                icon: 'ph:bold/pencil-simple',
                href: path('wexample_design_system_generic_overlays_modal_test_medium'),
                target: 'panel',
                target_options: { closeOnEscape: true, closeOnOverlayClick: true }
            },
        ] %}

        <section>
            <h2>{{ '@page::section.default.title' | trans }}</h2>
            {#- The third column is a date cell: the server prints the instant and
                the browser keeps counting from it, exactly as the vue table does. -#}
            {{ table(
                [
                    { key: 'name', label: '@page::column.default.name' | trans },
                    { key: 'date', label: '@page::column.default.date' | trans, secondary: true },
                    { key: 'seen', label: '@page::column.default.seen' | trans, cell: 'date', secondary: true },
                ],
                [
                    { name: '@page::row.one.title' | trans, date: '@page::row.one.meta' | trans, seen: '-40 seconds' },
                    { name: '@page::row.two.title' | trans, date: '@page::row.two.meta' | trans, seen: '-22 minutes' },
                    { name: '@page::row.three.title' | trans, date: '@page::row.three.meta' | trans, seen: '-3 hours' },
                ]
            ) }}
        </section>

        <section>
            <h2>{{ '@page::section.actions.title' | trans }}</h2>
            {{ table(
                actions_columns,
                [
                    { name: '@page::row.action.one.title' | trans, date: '@page::row.action.one.meta' | trans, operations: row_actions },
                    { name: '@page::row.action.two.title' | trans, date: '@page::row.action.two.meta' | trans, operations: row_actions },
                ]
            ) }}
        </section>

        <section>
            <h2>{{ '@page::section.links.title' | trans }}</h2>
            {{ table(
                [
                    { key: 'source', label: '@page::column.links.source' | trans, cell: 'link' },
                    { key: 'state', label: '@page::column.links.state' | trans, cell: 'icon', align: 'center' },
                ],
                [
                    { source: { label: '@page::row.action.one.title' | trans, href: '#' }, state: { icon: 'ph:bold/check-circle', href: '#' } },
                    { source: { label: '@page::row.action.two.title' | trans }, state: { icon: 'ph:bold/clock' } },
                ]
            ) }}
        </section>

        <section>
            <h2>{{ '@page::section.loading.title' | trans }}</h2>
            {{ table(actions_columns, [], {
                loading: true,
                loading_label: '@page::row.action.loading.label' | trans
            }) }}
        </section>

        <section>
            <h2>{{ '@page::section.empty.title' | trans }}</h2>
            {{ table(actions_columns, [], {
                empty_label: '@page::row.action.empty.label' | trans
            }) }}
        </section>

        <section>
            <h2>{{ '@page::section.alignment.title' | trans }}</h2>
            {{ table(
                [
                    { key: 'name', label: '@page::column.alignment.left' | trans },
                    { key: 'status', label: '@page::column.alignment.center' | trans, align: 'center' },
                    { key: 'amount', label: '@page::column.alignment.right' | trans, align: 'right' },
                ],
                [
                    { name: 'Alpha', status: 'Centered', amount: '42.00 €' },
                    { name: 'Beta', status: 'Centered', amount: '128.50 €' },
                    { name: 'Gamma', status: 'Centered', amount: '7.99 €' },
                ]
            ) }}
        </section>

        <section>
            <h2>{{ '@page::section.vue.title' | trans }}</h2>
            {{ vue_include(render_pass, '@WexampleSymfonyDesignSystemDemoBundle/vue/collection/table/demo-entity-table') }}
        </section>

        <section>
            <h2>{{ '@page::section.vue_compact.title' | trans }}</h2>
            <p>{{ '@page::section.vue_compact.description' | trans }}</p>
            {{ vue_include(render_pass, '@WexampleSymfonyDesignSystemDemoBundle/vue/collection/table/demo-compact-table') }}
        </section>

        <section>
            <h2>{{ '@page::section.vue_dates.title' | trans }}</h2>
            {{ vue_include(render_pass, '@WexampleSymfonyDesignSystemDemoBundle/vue/collection/table/demo-dates-table') }}
        </section>
{%- endblock -%}
