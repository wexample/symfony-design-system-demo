{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/data/layout/layout-data.html.twig' -%}

{%- block page_body -%}
    <h2>{{ '@page::section.default.title' | trans }}</h2>
    <div class="list-expanded">
        <div class="list-expanded--header">
            <div class="form--input-group form--filter list-expanded--search"><span class="form--input-addon" aria-hidden="true">{{ icon('ph:bold/magnifying-glass') }}</span><input class="form--input" type="search" placeholder="{{ '@page::search.placeholder' | trans }}"></div>
            {{ button('ph:bold/funnel', '@page::header.filter' | trans) }}
        </div>
        <div class="list-expanded--items">
            <a class="list-expanded--item" href="#" data-list-expanded-item>
                <strong>{{ '@page::item.postgres.title' | trans }}</strong>
                <span>{{ '@page::item.postgres.body' | trans }}</span>
            </a>
            <a class="list-expanded--item" href="#" data-list-expanded-item>
                <strong>{{ '@page::item.s3.title' | trans }}</strong>
                <span>{{ '@page::item.s3.body' | trans }}</span>
            </a>
            <a class="list-expanded--item" href="#" data-list-expanded-item>
                <strong>{{ '@page::item.webhook.title' | trans }}</strong>
                <span>{{ '@page::item.webhook.body' | trans }}</span>
            </a>
            <a class="list-expanded--item" href="#" data-list-expanded-item>
                <strong>{{ '@page::item.redis.title' | trans }}</strong>
                <span>{{ '@page::item.redis.body' | trans }}</span>
            </a>
            <a class="list-expanded--item" href="#" data-list-expanded-item>
                <strong>{{ '@page::item.mongo.title' | trans }}</strong>
                <span>{{ '@page::item.mongo.body' | trans }}</span>
            </a>
        </div>
    </div>

    <h2>{{ '@page::section.empty.title' | trans }}</h2>
    <div class="list-expanded">
        <div class="list-expanded--header">
            <div class="form--input-group form--filter list-expanded--search"><span class="form--input-addon" aria-hidden="true">{{ icon('ph:bold/magnifying-glass') }}</span><input class="form--input" type="search" placeholder="{{ '@page::search.placeholder' | trans }}"></div>
            {{ button('ph:bold/funnel', '@page::header.filter' | trans) }}
        </div>
        <div class="empty">{{ 'No items available.' }}</div>
    </div>

    <h2>{{ '@page::section.marked.title' | trans }}</h2>
    <p>{{ '@page::section.marked.body' | trans }}</p>
    {#- A mark of the design system's icons, an emoji, a character: the same column. -#}
    <div class="block block--padded">
        {{ item_list([
            { label: '@page::item.marked.read' | trans, icon: 'ph:bold/check', tone: 'success' },
            { label: '@page::item.marked.opened' | trans, icon: '✓', tone: 'success' },
            { label: '@page::item.marked.skipped' | trans, icon: 'ph:bold/warning', tone: 'warning' },
            { label: '@page::item.marked.refused' | trans, icon: '✗', tone: 'error' },
            { label: '@page::item.marked.night' | trans, icon: '🌙' },
        ]) }}
    </div>
    <div class="block block--padded">
        {{ item_list([
            { label: '@page::item.marked.read' | trans, icon: 'ph:bold/check', tone: 'success' },
            { label: '@page::item.marked.skipped' | trans, icon: 'ph:bold/warning', tone: 'warning' },
            { label: '@page::item.marked.refused' | trans, icon: 'ph:bold/x', tone: 'error' },
        ], { toned: 'line' }) }}
    </div>

    <h2>{{ '@page::section.period.title' | trans }}</h2>
    <p>{{ '@page::section.period.body' | trans }}</p>
    {{ vue(render_pass, '@WexampleSymfonyDesignSystemDemoBundle/components/demo-period') }}

    <h2>{{ '@page::section.edited.title' | trans }}</h2>
    <p>{{ '@page::section.edited.body' | trans }}</p>
    {{ vue(render_pass, '@WexampleSymfonyDesignSystemDemoBundle/components/demo-block-list') }}
{%- endblock -%}
