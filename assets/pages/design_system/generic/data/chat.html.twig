{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/data/layout/layout-data.html.twig' -%}
{% import _self as chat_macro %}

{% macro composer(rows, placeholder, submit_label, action_plus_label, action_smiley_label, content = '') %}
    <div class="composer">
        <div class="composer--field">
            <div class="composer--tools">
                <button
                    type="button"
                    aria-label="{{ action_plus_label }}"
                    title="{{ action_plus_label }}"
                >
                    {{ icon('ph:bold/plus') }}
                </button>
                <button
                    type="button"
                    aria-label="{{ action_smiley_label }}"
                    title="{{ action_smiley_label }}"
                >
                    {{ icon('ph:bold/smiley') }}
                </button>
            </div>
            <textarea
                rows="{{ rows }}"
                class="composer--textarea"
                placeholder="{{ placeholder }}"
            >{{ content }}</textarea>
            <button
                class="composer--submit"
                type="button"
                aria-label="{{ submit_label }}"
                title="{{ submit_label }}"
            >
                {{ icon('ph:bold/paper-plane-right') }}
            </button>
        </div>
    </div>
{% endmacro %}

{#- A line of a conversation between people: a face with its presence, a
    marker telling an agent apart, the line going on from the one before. -#}
{% macro person_line(face, author, date, content, marker = null, continued = false, own = false) %}
    <div class="thread--item{{ continued ? ' thread--item--continued' }}{{ own ? ' thread--item--own' }}">
        <div class="thread-message{{ own ? ' thread-message--own' }}">
            {{ face|raw }}
            <div class="thread-message--body">
                <div class="thread-message--meta">
                    <span class="thread-message--author">{{ author }}</span>
                    {%- if marker %} {{ marker|raw }}{% endif %}
                    {{ date_display(date, 'auto', { class: 'thread-message--date' }) }}
                </div>
                <div class="thread-message--content">{{ content }}</div>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro message(author, date, content) %}
    <div class="thread-message">
        <div class="avatar">
            {{ icon('ph:bold/user') }}
        </div>
        <div class="thread-message--body">
            <div class="thread-message--meta">
                <span class="thread-message--author">{{ author }}</span>
                {{ date_display(date, 'auto', { class: 'thread-message--date' }) }}
            </div>
            <div class="thread-message--content">
                {{ content }}
            </div>
        </div>
    </div>
{% endmacro %}

{%- block page_body -%}
        <div class="stack--horizontal">
            <div class="block block--fill">
                <div class="block--title">{{ '@page::chat.title' | trans }}</div>
                {#- The same assembly the Vue component emits, so what is shown here
                    is what a chat ships as. -#}
                <div class="chat">
                    <div class="thread">
                        <div class="thread--lines">
                            {{ chat_macro.message('Assistant', '-22 minutes', '@page::messages.assistant_1' | trans) }}
                            {{ chat_macro.message('Maya', '-18 minutes', '@page::messages.user_1' | trans) }}
                            {{ chat_macro.message('Assistant', '-12 minutes', '@page::messages.assistant_2' | trans) }}
                            {{ chat_macro.message('Maya', '-9 minutes', '@page::messages.user_2' | trans) }}
                            {{ chat_macro.message('Assistant', '-4 minutes', '@page::messages.assistant_3' | trans) }}
                            {{ chat_macro.message('Assistant', '-40 seconds', '@page::messages.assistant_4' | trans) }}
                        </div>
                    </div>
                    {{
                        chat_macro.composer(
                            1,
                            '@page::composer.placeholder' | trans,
                            '@page::composer.submit_label' | trans,
                            '@page::composer.action_plus_label' | trans,
                            '@page::composer.action_smiley_label' | trans
                        )
                    }}
                    {{
                        chat_macro.composer(
                            4,
                            '@page::composer.placeholder' | trans,
                            '@page::composer.submit_label' | trans,
                            '@page::composer.action_plus_label' | trans,
                            '@page::composer.action_smiley_label' | trans,
                            '@page::composer.multiline_value' | trans
                        )
                    }}
                </div>
            </div>
            <div class="block block--padded">
                <div class="lead">
                    {{ '@page::description.body' | trans }}
                </div>
            </div>
        </div>

        <h2>{{ '@page::people.title' | trans }}</h2>
        <div class="lead">{{ '@page::people.description' | trans }}</div>
        {%- set thread_words = 'WexampleSymfonyDesignSystemBundle.components.collection.thread.abstract-entity-thread.abstract-entity-thread::divider.' -%}
        {%- set face = '@WexampleSymfonyDesignSystemBundle/components/avatar' -%}
        <div class="block chat-demo--people">
            <div class="thread thread--flat">
                <div class="thread--lines">
                    <div class="thread--divider thread--divider--day" role="separator"><span class="thread--divider-label">{{ (thread_words ~ 'yesterday') | trans }}</span></div>
                    {{ chat_macro.person_line(component(render_pass, face, { label: 'Maya Chen', presence: 'online', class: 'thread-message--face' }), 'Maya Chen', '-1 day', '@page::messages.user_1' | trans) }}
                    {{ chat_macro.person_line(component(render_pass, face, { label: 'Maya Chen', presence: 'online', class: 'thread-message--face' }), 'Maya Chen', '-1 day', '@page::messages.user_2' | trans, null, true) }}
                    <div class="thread--divider thread--divider--day" role="separator"><span class="thread--divider-label">{{ (thread_words ~ 'today') | trans }}</span></div>
                    {{ chat_macro.person_line(component(render_pass, face, { label: 'Tom Ruiz', presence: 'away', class: 'thread-message--face' }), 'Tom Ruiz', '-25 minutes', '@page::messages.assistant_1' | trans) }}
                    <div class="thread--divider thread--divider--unread" role="separator"><span class="thread--divider-label">{{ (thread_words ~ 'unread') | trans }}</span></div>
                    {{ chat_macro.person_line(component(render_pass, face, { label: 'Assistant', emoji: '🤖', class: 'thread-message--face' }), 'Assistant', '-6 minutes', '@page::messages.assistant_2' | trans, marker('cat-plum', 'agent', { compact: true })) }}
                    {{ chat_macro.person_line(component(render_pass, face, { label: 'Assistant', emoji: '🤖', class: 'thread-message--face' }), 'Assistant', '-5 minutes', '@page::messages.assistant_3' | trans, marker('cat-plum', 'agent', { compact: true }), true) }}
                </div>
            </div>
        </div>

        <h2>{{ '@page::vue.title' | trans }}</h2>
        <div class="lead">{{ '@page::vue.description' | trans }}</div>
        {#- No padding here: the chat insets its own parts, and the two would stack. -#}
        <div class="block chat-demo--vue">
            {{ vue(render_pass, '@WexampleSymfonyDesignSystemDemoBundle/components/collection/chat/demo-entity-chat', { roomId: demo_room.id }) }}
        </div>
{%- endblock -%}
