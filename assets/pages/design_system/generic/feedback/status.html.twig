{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/feedback/layout/layout-feedback.html.twig' -%}

{%- set types = ['success', 'error', 'warning', 'info', 'running', 'pending', 'paused', 'play', 'skipped', 'disabled'] -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    <h2>{{ '@page::section.words.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.words.description' | trans }}</div>
    <div class="block block--padded stack--vertical" style="align-items: flex-start;">
        {{ status('success', '@page::state.success' | trans) }}
        {{ status('error', '@page::state.error' | trans) }}
        {{ status('warning', '@page::state.warning' | trans) }}
        {{ status('info', '@page::state.info' | trans) }}
    </div>

    <h2>{{ '@page::section.figures.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.figures.description' | trans }}</div>
    <div class="block block--padded cluster">
        {%- for type in types -%}
            <span class="status-demo--case">
                {{ status(type, null, { count: 15, compact: true }) }}
                <span class="text-secondary">{{ type }}</span>
            </span>
        {%- endfor -%}
    </div>

    <h2>{{ '@page::section.payload.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.payload.description' | trans }}</div>
    <div class="block block--padded cluster">
        {{ status('success', '@page::state.passed' | trans) }}
        {{ status('success', null, { count: 15 }) }}
        {{ status('success', '@page::state.passed' | trans, { count: 15 }) }}
        {{ status('success') }}
    </div>

    <h2>{{ '@page::section.weights.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.weights.description' | trans }}</div>
    <div class="block block--padded">
        <table class="table">
            <thead>
            <tr class="table--row">
                <th class="table--cell" scope="col">{{ '@page::weights.column.form' | trans }}</th>
                {%- for type in ['success', 'warning', 'error', 'skipped'] -%}
                    <th class="table--cell table--cell--center" scope="col">{{ type }}</th>
                {%- endfor -%}
            </tr>
            </thead>
            <tbody>
            <tr class="table--row">
                <td class="table--cell">{{ '@page::weights.row.capsule' | trans }}</td>
                {%- for type in ['success', 'warning', 'error', 'skipped'] -%}
                    <td class="table--cell table--cell--center">{{ status(type, null, { count: 15, compact: true }) }}</td>
                {%- endfor -%}
            </tr>
            <tr class="table--row">
                <td class="table--cell">{{ '@page::weights.row.circle' | trans }}</td>
                {%- for type in ['success', 'warning', 'error', 'skipped'] -%}
                    <td class="table--cell table--cell--center">{{ status_icon(type, { size: 'sm' }) }}</td>
                {%- endfor -%}
            </tr>
            </tbody>
        </table>
    </div>

    <h2>{{ '@page::section.circles.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.circles.description' | trans }}</div>
    <div class="cluster">
        {%- for type in types -%}
            <span class="status-demo--case">
                {{ status_icon(type, { size: 'lg', label: type }) }}
                <span class="text-secondary">{{ type }}</span>
            </span>
        {%- endfor -%}
    </div>

    <h2>{{ '@page::section.progress.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.progress.description' | trans }}</div>
    <div class="cluster">
        {%- for step in [0, 0.25, 0.5, 0.75, 1] -%}
            <span class="status-demo--case">
                {{ status_icon('running', { size: 'lg', progress: step }) }}
                <span class="text-secondary">{{ (step * 100) | round }}%</span>
            </span>
        {%- endfor -%}
    </div>

    <h2>{{ '@page::section.sizes.title' | trans }}</h2>
    <div class="cluster">
        {{ status_icon('success', { size: 'sm' }) }}
        {{ status_icon('success') }}
        {{ status_icon('success', { size: 'lg' }) }}
    </div>

    <h2>{{ '@page::section.vue.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.vue.description' | trans }}</div>
    <div class="block block--padded">
        {{ vue(render_pass, '@WexampleSymfonyDesignSystemDemoBundle/components/demo-status-icons') }}
    </div>

    <h2>{{ '@page::section.code.title' | trans }}</h2>
    {%- set code -%}
        {%- verbatim %}{{ status('success', 'Operation successful') }}
{{ status('success', null, { count: 15, compact: true }) }}
{{ status_icon('running', { progress: 0.4 }) }}{%- endverbatim -%}
    {%- endset -%}
    {{ include('@WexampleSymfonyDesignSystemBundle/components/code-block/code-block.html.twig', {lang: 'twig', code: code}) }}
{%- endblock -%}
