{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/feedback/layout/layout-feedback.html.twig' -%}

{%- block page_body -%}
    <h2>{{ '@page::section.variants.title' | trans }}</h2>
    <div class="stack--vertical" style="align-items: flex-start;">
        {{ include('@WexampleSymfonyDesignSystemBundle/components/status/status.html.twig', {
            type: 'success',
            icon_name: 'ph:bold/check-circle',
            label: '@page::status.success' | trans
        }) }}
        {{ include('@WexampleSymfonyDesignSystemBundle/components/status/status.html.twig', {
            type: 'error',
            icon_name: 'ph:bold/x-circle',
            label: '@page::status.error' | trans
        }) }}
        {{ include('@WexampleSymfonyDesignSystemBundle/components/status/status.html.twig', {
            type: 'warning',
            icon_name: 'ph:bold/warning',
            label: '@page::status.warning' | trans
        }) }}
        {{ include('@WexampleSymfonyDesignSystemBundle/components/status/status.html.twig', {
            type: 'info',
            icon_name: 'ph:bold/info',
            label: '@page::status.info' | trans
        }) }}
    </div>

    <h2>{{ '@page::section.circles.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.circles.description' | trans }}</div>
    <div class="cluster">
        {%- for type in ['success', 'error', 'warning', 'running', 'pending', 'paused', 'play', 'skipped', 'disabled'] -%}
            <span class="status-demo--case">
                {{ status_icon(type, { size: 'lg', label: type }) }}
                <span class="text-secondary">{{ type }}</span>
            </span>
        {%- endfor -%}
    </div>

    <h2>{{ '@page::section.tags.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.tags.description' | trans }}</div>
    <div class="cluster">
        {%- for type in ['success', 'error', 'warning', 'running', 'pending', 'paused', 'play', 'skipped', 'disabled'] -%}
            <span class="status-demo--case">
                {{ status_tag(type, 15) }}
                <span class="text-secondary">{{ type }}</span>
            </span>
        {%- endfor -%}
    </div>

    <h2>{{ '@page::section.tags_forms.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.tags_forms.description' | trans }}</div>
    <div class="cluster">
        {{ status_tag('success', 15) }}
        {{ status_tag('success') }}
        {{ status_tag('warning', '3 flaky', { title: '@page::tag.flaky' | trans }) }}
        {{ status_tag('info', '1.2k') }}
    </div>

    <h2>{{ '@page::section.tags_compare.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.tags_compare.description' | trans }}</div>
    <div class="block block--padded">
        <table class="table">
            <thead>
            <tr class="table--row">
                <th class="table--cell" scope="col">{{ '@page::compare.column.form' | trans }}</th>
                {%- for type in ['success', 'warning', 'error', 'skipped'] -%}
                    <th class="table--cell table--cell--center" scope="col">{{ type }}</th>
                {%- endfor -%}
            </tr>
            </thead>
            <tbody>
            <tr class="table--row">
                <td class="table--cell">{{ '@page::compare.row.icon' | trans }}</td>
                {%- for type in ['success', 'warning', 'error', 'skipped'] -%}
                    <td class="table--cell table--cell--center">
                        <span class="table--status">
                            {{- status_icon(type, { size: 'sm' }) -}}
                            <span class="pill">15</span>
                        </span>
                    </td>
                {%- endfor -%}
            </tr>
            <tr class="table--row">
                <td class="table--cell">{{ '@page::compare.row.tag' | trans }}</td>
                {%- for type in ['success', 'warning', 'error', 'skipped'] -%}
                    <td class="table--cell table--cell--center">{{ status_tag(type, 15) }}</td>
                {%- endfor -%}
            </tr>
            </tbody>
        </table>
    </div>

    <h2>{{ '@page::section.progress.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.progress.description' | trans }}</div>
    <div class="cluster">
        {%- for step in [0, 0.25, 0.5, 0.75, 1] -%}
            <span class="status-demo--case">
                {{ status_icon('running', { size: 'lg', progress: step }) }}
                <span class="text-secondary">{{ (step * 100) | round }}%</span>
            </span>
        {%- endfor -%}
    </div>

    <h2>{{ '@page::section.sizes.title' | trans }}</h2>
    <div class="cluster">
        {{ status_icon('success', { size: 'sm' }) }}
        {{ status_icon('success') }}
        {{ status_icon('success', { size: 'lg' }) }}
    </div>

    <h2>{{ '@page::section.vue.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.vue.description' | trans }}</div>
    <div class="block block--padded">
        {{ vue(render_pass, '@WexampleSymfonyDesignSystemDemoBundle/components/partials/demo-status-icons') }}
    </div>

    <h2>{{ '@page::section.code.title' | trans }}</h2>
    {%- set code -%}
        {%- verbatim %}{{ include('@WexampleSymfonyDesignSystemBundle/components/status/status.html.twig', {
    type: 'success',
    icon_name: 'ph:bold/check-circle',
    label: 'Operation successful'
}) }}{%- endverbatim -%}
    {%- endset -%}
    {{ include('@WexampleSymfonyDesignSystemBundle/components/code-block/code-block.html.twig', {lang: 'twig', code: code}) }}
{%- endblock -%}
