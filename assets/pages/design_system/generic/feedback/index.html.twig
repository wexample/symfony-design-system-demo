{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/feedback/layout/layout-feedback.html.twig' -%}
{%- import '@WexampleSymfonyDesignSystemDemoBundle/partials/overview.html.twig' as overview -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    {{ overview.pages(render_pass, [
        { route: 'wexample_design_system_generic_feedback_toasts', icon: 'ph:bold/bell', title: '@page::page.toasts.title' | trans, description: '@page::page.toasts.description' | trans },
        { route: 'wexample_design_system_generic_feedback_banners', icon: 'ph:bold/flag', title: '@page::page.banners.title' | trans, description: '@page::page.banners.description' | trans },
        { route: 'wexample_design_system_generic_feedback_messages', icon: 'ph:bold/chat-text', title: '@page::page.messages.title' | trans, description: '@page::page.messages.description' | trans },
        { route: 'wexample_design_system_generic_feedback_status', icon: 'ph:bold/seal-check', title: '@page::page.status.title' | trans, description: '@page::page.status.description' | trans },
        { route: 'wexample_design_system_generic_feedback_loaders', icon: 'ph:bold/spinner-gap', title: '@page::page.loaders.title' | trans, description: '@page::page.loaders.description' | trans },
        { route: 'wexample_design_system_generic_feedback_progress', icon: 'ph:bold/gauge', title: '@page::page.progress.title' | trans, description: '@page::page.progress.description' | trans },
        { route: 'wexample_design_system_generic_feedback_distribution', icon: 'ph:bold/chart-bar-horizontal', title: '@page::page.distribution.title' | trans, description: '@page::page.distribution.description' | trans },
        { route: 'wexample_design_system_generic_feedback_errors', icon: 'ph:bold/warning-circle', title: '@page::page.errors.title' | trans, description: '@page::page.errors.description' | trans }
    ]) }}
{%- endblock -%}
