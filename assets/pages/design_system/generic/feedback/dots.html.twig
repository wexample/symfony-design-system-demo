{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/feedback/layout/layout-feedback.html.twig' -%}


{%- block page_body -%}
    <div class="stack--vertical">
        <div class="block block--padded block--vertical">
            <h2>{{ '@page::section.sizes.title' | trans }}</h2>
            <div class="lead">
                {{ '@page::section.sizes.description' | trans }}
            </div>
        </div>
        <div class="stack--horizontal">
            <div class="block block--padded">
                {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/dots', {
                    size: 'sm',
                    align: 'center',
                    label: '@page::label.waiting' | trans
                }) }}
            </div>
            <div class="block block--padded">
                {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/dots', {
                    align: 'center',
                    label: '@page::label.waiting' | trans
                }) }}
            </div>
            <div class="block block--padded">
                {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/dots', {
                    size: 'lg',
                    align: 'center',
                    label: '@page::label.waiting' | trans
                }) }}
            </div>
        </div>
        <div class="block block--padded block--vertical">
            <h2>{{ '@page::section.inline.title' | trans }}</h2>
            <div class="lead">
                {{ '@page::section.inline.description' | trans }}
            </div>
        </div>
        <div class="block block--padded">
            {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/dots', {
                align: 'inline',
                label: '@page::label.waiting' | trans
            }) }}
            <span>{{ '@page::inline.text' | trans }}</span>
        </div>
        <div class="block block--padded">
            {{ vue(render_pass, '@WexampleSymfonyDesignSystemBundle/vue/partials/dots', {
                size: 'lg',
                align: 'center',
                label: '@page::label.waiting' | trans
            }) }}
        </div>
    </div>
{%- endblock -%}
