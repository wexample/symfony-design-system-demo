{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/feedback/layout/layout-feedback.html.twig' -%}

{% import _self as message_macro %}

{% macro render_messages() %}
    <div class="stack--vertical">
        {{ message_info(
            '@page::message.info.title' | trans,
            '@page::message.info.body' | trans
        ) }}
        {{ message_success(
            '@page::message.success.title' | trans,
            '@page::message.success.body' | trans
        ) }}
        {{ message_warning(
            '@page::message.warning.title' | trans,
            '@page::message.warning.body' | trans
        ) }}
        {{ message_error(
            '@page::message.error.title' | trans,
            '@page::message.error.body' | trans
        ) }}
    </div>
{% endmacro %}

{% macro render_compact_messages() %}
    <div class="stack--vertical">
        {{ message_warning('@page::compact.rule.one' | trans, null, { compact: true }) }}
        {{ message_warning('@page::compact.rule.two' | trans, null, { compact: true }) }}
        {{ message_info('@page::compact.rule.three' | trans, null, { compact: true }) }}
    </div>
{% endmacro %}

{%- block page_body -%}
        <h2>{{ '@page::section.default.title' | trans }}</h2>
        {{ message_macro.render_messages() | raw }}
        <h2>{{ '@page::section.compact.title' | trans }}</h2>
        <div class="lead">{{ '@page::section.compact.description' | trans }}</div>
        {{ message_macro.render_compact_messages() | raw }}
        <h2>{{ '@page::section.block.title' | trans }}</h2>
        <div class="block block--padded">
            {{ message_macro.render_messages() | raw }}
        </div>

        <h2>{{ '@page::section.vue.title' | trans }}</h2>
        <div class="lead">{{ '@page::section.vue.description' | trans }}</div>
        <div class="stack--vertical">
            {% for type in ['info', 'success', 'warning', 'error'] %}
                {{ vue(render_pass, '@WexampleSymfonyDesignSystemBundle/components/message', {
                    type: type,
                    title: ('@page::message.' ~ type ~ '.title') | trans,
                    body: ('@page::message.' ~ type ~ '.body') | trans
                }) }}
            {% endfor %}
            {{ vue(render_pass, '@WexampleSymfonyDesignSystemBundle/components/message', {
                type: 'info',
                title: '@page::compact.rule.one' | trans,
                compact: true
            }) }}
        </div>
{%- endblock -%}
