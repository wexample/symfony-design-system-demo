{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/content/layout/layout-content.html.twig' -%}
{%- import '@WexampleSymfonyDesignSystemDemoBundle/partials/overview.html.twig' as overview -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    {{ overview.pages(render_pass, [
        { route: 'wexample_design_system_generic_content_composition', icon: 'ph:bold/layout', title: '@page::page.composition.title' | trans, description: '@page::page.composition.description' | trans },
        { route: 'wexample_design_system_generic_content_media', icon: 'ph:bold/image', title: '@page::page.media.title' | trans, description: '@page::page.media.description' | trans },
        { route: 'wexample_design_system_generic_content_dates', icon: 'ph:bold/clock', title: '@page::page.dates.title' | trans, description: '@page::page.dates.description' | trans },
        { route: 'wexample_design_system_generic_content_timeline', icon: 'ph:bold/list-numbers', title: '@page::page.timeline.title' | trans, description: '@page::page.timeline.description' | trans },
        { route: 'wexample_design_system_generic_content_console', icon: 'ph:bold/terminal-window', title: '@page::page.console.title' | trans, description: '@page::page.console.description' | trans }
    ]) }}
{%- endblock -%}
