{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/content/layout/layout-content.html.twig' -%}

{%- set placeholder_svg -%}
<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 100 100">
    <rect width="100" height="100" fill="none"/>
    <line x1="0" y1="0" x2="100" y2="100" stroke="currentColor" stroke-width="1" opacity="0.3"/>
    <line x1="100" y1="0" x2="0" y2="100" stroke="currentColor" stroke-width="1" opacity="0.3"/>
</svg>
{%- endset -%}

{%- block page_body -%}
    <h2>{{ '@page::section.shapes.title' | trans }}</h2>
    <div class="stack--horizontal">
        <div class="block block--padded" style="flex: 1">
            <div class="media media--square media-demo--bg-primary">
                {{ placeholder_svg | raw }}
            </div>
            <p>square</p>
        </div>
        <div class="block block--padded" style="flex: 1">
            <div class="media media--round media-demo--bg-secondary">
                {{ placeholder_svg | raw }}
            </div>
            <p>round</p>
        </div>
        <div class="block block--padded" style="flex: 1">
            <div class="media media--cover media-demo--bg-accent" style="height: 8rem;">
                {{ placeholder_svg | raw }}
            </div>
            <p>cover</p>
        </div>
    </div>

    <h2>{{ '@page::section.aspect_ratio.title' | trans }}</h2>
    <div class="stack--horizontal">
        <div class="block block--padded" style="flex: 1">
            <div class="media media--cover media--16-9 media-demo--bg-primary">
                {{ placeholder_svg | raw }}
            </div>
            <p>cover + 16-9</p>
        </div>
    </div>

    <h2>{{ '@page::section.document.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.document.description' | trans }}</div>
    <div class="stack--horizontal">
        <div class="block block--padded" style="flex: 1">
            <div style="height: 20rem;">
                {{ document_embed(
                    path('wexample_design_system_fixtures_placeholder_pdf'),
                    '@page::document.title' | trans,
                    { actions: [
                        { icon: 'ph:bold/arrow-square-out', label: 'WexampleSymfonyDesignSystemBundle.common.system::frontend.document.open', href: path('wexample_design_system_fixtures_placeholder_pdf'), new_window: true },
                        { icon: 'ph:bold/download-simple', label: 'WexampleSymfonyDesignSystemBundle.common.system::frontend.document.download', href: path('wexample_design_system_fixtures_placeholder_pdf'), download: true },
                    ] }
                ) }}
            </div>
            <p>media--fill · actions</p>
        </div>
        <div class="block block--padded" style="flex: 1">
            {{ document_embed(
                path('wexample_design_system_fixtures_placeholder_pdf'),
                '@page::document.title' | trans,
                { ratio: '16-9' }
            ) }}
            <p>16-9</p>
        </div>
    </div>

    <h2>{{ '@page::section.overlay.title' | trans }}</h2>
    <div class="stack--horizontal">
        <div class="block block--padded" style="flex: 1">
            <div class="media media-demo--bg-primary" style="height: 8rem;">
                <div class="media--bg media-demo--bg-secondary" style="opacity: 0.5;"></div>
                <div class="media--fg" style="display: flex; align-items: center; justify-content: center; height: 100%; color: white;">
                    media--bg / media--fg
                </div>
            </div>
        </div>
    </div>

    <h2>{{ '@page::section.vue.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.vue.description' | trans }}</div>
    <div class="block block--padded">
        {{ vue(render_pass, '@WexampleSymfonyDesignSystemBundle/components/document-embed', {
            src: path('wexample_design_system_fixtures_placeholder_pdf'),
            title: '@page::document.title' | trans,
            ratio: '16-9'
        }) }}
    </div>

    <h2>{{ '@page::section.frame.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.frame.description' | trans }}</div>
    <div class="stack--horizontal">
        <div class="block block--padded" style="flex: 1">
            {{ media(path('wexample_design_system_fixtures_placeholder_svg'), '', { width: 400, height: 300, href: '#', caption: '@page::wall.caption' | trans, class: 'media--4-3 media--cover' }) }}
            <p>media() · href · caption</p>
        </div>
        <div class="block block--padded" style="flex: 1">
            {{ media(null, '', { class: 'media--4-3' }) }}
            <p>media(null) · placeholder</p>
        </div>
    </div>

    {#- Pictures drawn on the spot, each at its own ratio and hue, and one
        missing, which the placeholder stands for. -#}
    {%- set wall_items = [] -%}
    {%- for index in 0..13 -%}
        {%- set ratio = [[4, 3], [3, 4], [1, 1], [16, 9], [2, 3], [3, 2], [9, 16]][index % 7] -%}
        {%- set hue = (index * 47) % 360 -%}
        {%- set svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ' ~ ratio[0] ~ ' ' ~ ratio[1] ~ '"><rect width="100%" height="100%" fill="hsl(' ~ hue ~ ' 60% 55%)"/></svg>' -%}
        {%- set wall_items = wall_items|merge([{
            src: index == 5 ? null : 'data:image/svg+xml,' ~ svg|url_encode,
            width: ratio[0] * 300,
            height: ratio[1] * 300,
            href: '#',
            caption: ratio[0] ~ ':' ~ ratio[1],
        }]) -%}
    {%- endfor -%}

    <h2>{{ '@page::section.wall.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.wall.description' | trans }}</div>
    {{ wall(wall_items) }}

    <h2>{{ '@page::section.wall_vue.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.wall_vue.description' | trans }}</div>
    {{ vue_include(render_pass, '@WexampleSymfonyDesignSystemDemoBundle/components/collection/wall/demo-entity-wall') }}

    <h2>{{ '@page::section.crop.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.crop.description' | trans }}</div>
    {{ vue(render_pass, '@WexampleSymfonyDesignSystemDemoBundle/components/demo-image-crop') }}
{%- endblock -%}
