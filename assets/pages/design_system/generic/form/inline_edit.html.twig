{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/form/layout/layout-form.html.twig' -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    <h2>{{ '@page::section.title.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.title.description' | trans }}</div>
    {#- The form is never drawn: handed to the vue, sent to its processor. -#}
    <div class="block block--padded inline-edit-demo">
        {{ vue(render_pass, '@WexampleSymfonyDesignSystemBundle/components/form/inline-edit', {
            form: form_props(form_inline_edit_demo),
            field: 'title',
            label: '@page::label' | trans,
        }) }}
        {#- Bare: the text as it is, its pencil under the pointer — a title
            in a header. -#}
        <h3 class="inline-edit-demo--bare">
            {{ vue(render_pass, '@WexampleSymfonyDesignSystemBundle/components/form/inline-edit', {
                form: form_props(form_inline_edit_demo),
                field: 'title',
                label: '@page::label' | trans,
                bare: true,
            }) }}
        </h3>
        {{ vue(render_pass, '@WexampleSymfonyDesignSystemDemoBundle/components/form/demo-inline-edit', {
            form: form_props(form_inline_edit_demo),
            label: '@page::label' | trans,
        }) }}
    </div>

    <h2>{{ '@page::section.props_form.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.props_form.description' | trans }}</div>
    {#- The same form whole, each field by its kind. -#}
    <div class="block block--padded">
        {{ vue(render_pass, '@WexampleSymfonyDesignSystemBundle/components/form/props-form', {
            form: form_props(form_inline_edit_demo),
        }) }}
    </div>
{%- endblock -%}
