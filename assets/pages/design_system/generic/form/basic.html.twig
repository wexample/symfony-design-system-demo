{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/form/layout/layout-form.html.twig' -%}

{%- block page_body -%}
        <h2>{{ '@page::section.default.title' | trans }}</h2>
        <form class="form">
            <div class="form--group">
                <label class="form--label" for="form-title">{{ '@page::field.title.label' | trans }}</label>
                <input class="form--input" id="form-title" type="text"
                       placeholder="{{ '@page::field.title.placeholder' | trans }}">
            </div>
            <div class="form--group">
                <label class="form--label" for="form-message">{{ '@page::field.message.label' | trans }}</label>
                <textarea class="form--textarea" id="form-message" rows="4"
                          placeholder="{{ '@page::field.message.placeholder' | trans }}"></textarea>
            </div>
            <div class="form--group">
                <label class="form--label" for="form-date">{{ '@page::field.date.label' | trans }}</label>
                <input class="form--input" id="form-date" type="date">
            </div>
            <div class="form--group">
                <label class="form--label" for="form-datetime">{{ '@page::field.datetime.label' | trans }}</label>
                <input class="form--input" id="form-datetime" type="datetime-local">
            </div>
            <div class="form--group">
                <label class="form--label" for="form-time">{{ '@page::field.time.label' | trans }}</label>
                <input class="form--input" id="form-time" type="time">
            </div>
            <div class="form--group">
                <label class="form--label" for="form-file">{{ '@page::field.file.label' | trans }}</label>
                <input class="form--input form--input-file" id="form-file" type="file">
            </div>
            <div class="form--group">
                <label class="form--label" for="form-email">{{ '@page::field.email.label' | trans }}</label>
                <input class="form--input" id="form-email" type="email" placeholder="you@example.com">
            </div>
            <div class="form--group">
                <label class="form--label" for="form-number">{{ '@page::field.number.label' | trans }}</label>
                <input class="form--input" id="form-number" type="number">
            </div>
            <div class="form--group">
                <label class="form--label" for="form-url">{{ '@page::field.url.label' | trans }}</label>
                <input class="form--input" id="form-url" type="url" placeholder="https://">
            </div>
            <div class="form--actions">
                <a href="#">{{ '@page::action.link' | trans }}</a>
                {{ button('ph:bold/island', '@page::action.secondary' | trans) }}
                {{ form_submit('ph:bold/paper-plane-tilt', '@page::action.submit' | trans) }}
            </div>
        </form>
        {#- Fields side by side, as many columns as the room holds and three at
            most; a field among them may take the whole line. Two sections as
            regions of their own, side by side when the room allows. -#}
        <h2>{{ '@page::section.columns.title' | trans }}</h2>
        <p>{{ '@page::section.columns.description' | trans }}</p>
        <form class="form">
            <fieldset class="form--section form--columns">
                <legend>{{ '@page::section.columns.identity' | trans }}</legend>
                <div class="form--group">
                    <label class="form--label" for="columns-title">{{ '@page::field.title.label' | trans }}</label>
                    <input class="form--input" id="columns-title" type="text">
                </div>
                <div class="form--group">
                    <label class="form--label" for="columns-email">{{ '@page::field.email.label' | trans }}</label>
                    <input class="form--input" id="columns-email" type="email">
                </div>
                <div class="form--group">
                    <label class="form--label" for="columns-date">{{ '@page::field.date.label' | trans }}</label>
                    <input class="form--input" id="columns-date" type="date">
                </div>
                <div class="form--group">
                    <label class="form--label" for="columns-number">{{ '@page::field.number.label' | trans }}</label>
                    <input class="form--input" id="columns-number" type="number">
                </div>
                <div class="form--group">
                    <label class="form--label" for="columns-url">{{ '@page::field.url.label' | trans }}</label>
                    <input class="form--input" id="columns-url" type="url">
                </div>
                <div class="form--group">
                    <label class="form--label" for="columns-time">{{ '@page::field.time.label' | trans }}</label>
                    <input class="form--input" id="columns-time" type="time">
                </div>
                <div class="form--group form--span">
                    <label class="form--label" for="columns-message">{{ '@page::field.message.label' | trans }}</label>
                    <textarea class="form--textarea" id="columns-message" rows="3"></textarea>
                </div>
            </fieldset>
        </form>
        <form class="form form--zones">
            <fieldset class="form--section form--columns form--columns-2">
                <legend>{{ '@page::section.columns.identity' | trans }}</legend>
                <div class="form--group">
                    <label class="form--label" for="zones-title">{{ '@page::field.title.label' | trans }}</label>
                    <input class="form--input" id="zones-title" type="text">
                </div>
                <div class="form--group">
                    <label class="form--label" for="zones-email">{{ '@page::field.email.label' | trans }}</label>
                    <input class="form--input" id="zones-email" type="email">
                </div>
            </fieldset>
            <fieldset class="form--section form--columns form--columns-2">
                <legend>{{ '@page::section.columns.settings' | trans }}</legend>
                <div class="form--group">
                    <label class="form--label" for="zones-date">{{ '@page::field.date.label' | trans }}</label>
                    <input class="form--input" id="zones-date" type="date">
                </div>
                <div class="form--group">
                    <label class="form--label" for="zones-number">{{ '@page::field.number.label' | trans }}</label>
                    <input class="form--input" id="zones-number" type="number">
                </div>
            </fieldset>
            <div class="form--actions">
                {{ form_submit('ph:bold/paper-plane-tilt', '@page::action.submit' | trans) }}
            </div>
        </form>
        <h2>{{ '@page::section.block.title' | trans }}</h2>
        <div class="block block--padded">
            <form class="form">
                <div class="stack--horizontal">
                    <div class="form--group">
                        <label class="form--label" for="form-title">{{ '@page::field.title.label' | trans }}</label>
                        <input class="form--input" id="form-title" type="text"
                               placeholder="{{ '@page::field.title.placeholder' | trans }}">
                    </div>
                    <div class="form--group">
                        <label class="form--label" for="form-title">{{ '@page::field.title.label' | trans }}</label>
                        <input class="form--input" id="form-title" type="text"
                               placeholder="{{ '@page::field.title.placeholder' | trans }}">
                    </div>
                </div>
                <div class="form--actions">
                    <input type="submit" value="{{ '@page::action.raw_submit' | trans }}">
                </div>
            </form>
        </div>
        <div class="block block--padded block--vertical">
            <h2>{{ '@page::section.assisted.title' | trans }}</h2>
            <form class="form is-assisted">
                <div class="form--group">
                    <label class="form--label"
                           for="form-assisted-title">{{ '@page::field.title.label' | trans }}</label>
                    <input class="form--input" id="form-assisted-title" type="text"
                           placeholder="{{ '@page::field.title.placeholder' | trans }}">
                </div>
                <div class="form--actions">
                    {{ form_submit('ph:bold/paper-plane-tilt', '@page::action.submit' | trans) }}
                </div>
            </form>
        </div>
{%- endblock -%}
