{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/layout/layout/layout-generic.html.twig' -%}

{%- block page_title_actions -%}
    <a href="#" class="toolbar--link" title="{{ '@page::button.history' | trans }}">{{ icon('ph:bold/clock-clockwise') }}</a>
    <a href="#" class="toolbar--link" title="{{ '@page::button.share' | trans }}">{{ icon('ph:bold/share-network') }}</a>
    {{ button('ph:bold/pencil-simple', '@page::button.edit' | trans) }}
{%- endblock -%}

{%- block page_body -%}
        <section>
            <h2>{{ '@page::section.default.title' | trans }}</h2>
            <div class="toolbar toolbar--shaded">
                <div class="toolbar--group">
                    {{ button('ph:bold/plus', '@page::button.create' | trans) }}
                    {{ button('ph:bold/arrows-clockwise', '@page::button.refresh' | trans) }}
                </div>
                <div class="toolbar--group align-right">
                    {{ button('ph:bold/export', '@page::button.export' | trans) }}
                </div>
            </div>
        </section>

        <section>
            <h2>{{ '@page::section.title.title' | trans }}</h2>
            <div class="toolbar">
                <h1 class="toolbar--title">{{ '@page::title.example' | trans }}</h1>
                <div class="toolbar--group">
                    <a href="#" class="toolbar--link" title="{{ '@page::button.history' | trans }}">{{ icon('ph:bold/clock-clockwise') }}</a>
                    <a href="#" class="toolbar--link" title="{{ '@page::button.share' | trans }}">{{ icon('ph:bold/share-network') }}</a>
                    {{ button('ph:bold/pencil-simple', '@page::button.edit' | trans) }}
                    {{ button('ph:bold/trash', '@page::button.delete' | trans) }}
                </div>
            </div>
        </section>

        <section>
            <h2>{{ '@page::section.markers.title' | trans }}</h2>
            <div class="lead">{{ '@page::section.markers.description' | trans }}</div>
            <div class="toolbar">
                <div class="toolbar--group">
                    <h2 class="toolbar--title">{{ '@page::title.document' | trans }}</h2>
                    {{ marker('neutral', 'DEV-P-01', { compact: true }) }}
                    {{ marker('success', '@page::marker.state' | trans, { compact: true }) }}
                    {{ marker('neutral', 'v3.2', { compact: true }) }}
                </div>
                <div class="toolbar--group">
                    {{ button('ph:bold/file-pdf', '@page::button.export' | trans) }}
                </div>
            </div>
        </section>

        <section>
            <h2>{{ '@page::section.title_multi.title' | trans }}</h2>
            <div class="toolbar">
                <h2 class="toolbar--title">{{ '@page::title.section' | trans }}</h2>
                <div class="toolbar--group">
                    {{ button('ph:bold/plus', '@page::button.create' | trans) }}
                    {{ button('ph:bold/export', '@page::button.export' | trans) }}
                    {{ button('ph:bold/arrows-clockwise', '@page::button.refresh' | trans) }}
                </div>
            </div>
        </section>

        <section>
            <h2>{{ '@page::section.fields.title' | trans }}</h2>
            <div class="lead">{{ '@page::section.fields.description' | trans }}</div>
            <div class="toolbar toolbar--shaded toolbar--compact">
                <div class="toolbar--group">
                    <label class="toolbar--field">
                        <span class="toolbar--field-label">{{ '@page::field.size' | trans }}</span>
                        <input type="number" class="form--input" value="12" size="3">
                    </label>
                    <label class="toolbar--field">
                        <span class="toolbar--field-label">{{ '@page::field.mode' | trans }}</span>
                        <select class="form--input">
                            <option>{{ '@page::field.mode_normal' | trans }}</option>
                            <option>{{ '@page::field.mode_multiply' | trans }}</option>
                        </select>
                    </label>
                    <label class="checkbox-option">
                        <input type="checkbox" class="form--checkbox" checked>
                        <span class="form--checkbox-label">{{ '@page::field.snap' | trans }}</span>
                    </label>
                    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/switch', {}, {
                        label: '@page::field.preview' | trans,
                        label_position: 'left',
                        checked: true,
                    }) }}
                    <div class="radio-group radio-group--segmented" role="radiogroup">
                        <label class="radio-option">
                            <input type="radio" class="form--radio" name="toolbar-demo-align" checked>
                            <span class="form--radio-label">{{ icon('ph:bold/text-align-left') }}</span>
                        </label>
                        <label class="radio-option">
                            <input type="radio" class="form--radio" name="toolbar-demo-align">
                            <span class="form--radio-label">{{ icon('ph:bold/text-align-center') }}</span>
                        </label>
                        <label class="radio-option">
                            <input type="radio" class="form--radio" name="toolbar-demo-align">
                            <span class="form--radio-label">{{ icon('ph:bold/text-align-right') }}</span>
                        </label>
                    </div>
                </div>
                <form class="form--inline" onsubmit="return false">
                    <input type="search" class="form--input" placeholder="{{ '@page::field.search' | trans }}">
                    {{ button('ph:bold/magnifying-glass', '@page::button.search' | trans) }}
                </form>
            </div>

            <div class="toolbar toolbar--shaded">
                <form class="form--inline" onsubmit="return false">
                    <input type="text" class="form--input" placeholder="{{ '@page::field.message' | trans }}">
                    {{ button('ph:bold/paper-plane-tilt', '@page::button.send' | trans) }}
                </form>
                <div class="toolbar--group">
                    <label class="toolbar--field">
                        <span class="toolbar--field-label">{{ '@page::field.mode' | trans }}</span>
                        <select class="form--input">
                            <option>{{ '@page::field.mode_normal' | trans }}</option>
                            <option>{{ '@page::field.mode_multiply' | trans }}</option>
                        </select>
                    </label>
                </div>
            </div>
        </section>
{%- endblock -%}
