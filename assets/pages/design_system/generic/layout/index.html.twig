{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/layout/layout/layout-generic.html.twig' -%}
{%- import '@WexampleSymfonyDesignSystemDemoBundle/partials/overview.html.twig' as overview -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    {{ overview.pages(render_pass, [
        { route: 'wexample_design_system_generic_layout_zones', icon: 'ph:bold/columns', title: '@page::page.zones.title' | trans, description: '@page::page.zones.description' | trans },
        { route: 'wexample_design_system_generic_layout_blocks', icon: 'ph:bold/squares-four', title: '@page::page.blocks.title' | trans, description: '@page::page.blocks.description' | trans },
        { route: 'wexample_design_system_generic_layout_toolbar', icon: 'ph:bold/toolbox', title: '@page::page.toolbar.title' | trans, description: '@page::page.toolbar.description' | trans },
        { route: 'wexample_design_system_generic_layout_tabs', icon: 'ph:bold/tabs', title: '@page::page.tabs.title' | trans, description: '@page::page.tabs.description' | trans },
        { route: 'wexample_design_system_generic_layout_doc', icon: 'ph:bold/book-open', title: '@page::page.doc.title' | trans, description: '@page::page.doc.description' | trans }
    ]) }}
{%- endblock -%}
