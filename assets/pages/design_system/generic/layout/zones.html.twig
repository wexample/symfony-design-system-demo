{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/layout/layout/layout-generic.html.twig' -%}

{%- macro filler(count, prefix) -%}
    {%- for i in 1..count -%}
        <p>{{ prefix }} {{ i }}</p>
    {%- endfor -%}
{%- endmacro -%}

{%- block page_body -%}
    {% import _self as demo %}

    <p class="lead">{{ '@page::intro' | trans }}</p>

    <h2>{{ '@page::section.split.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.split.description' | trans }}</div>
    <div class="zone zone--split zone-demo--frame">
        <div class="zone zone--narrow zone--size-6 zone--padded zone--panel">
            <strong>zone--narrow zone--size-6</strong>
        </div>
        <div class="zone zone--padded zone--panel">
            <strong>zone</strong>
            <p>{{ '@page::split.body' | trans }}</p>
        </div>
    </div>

    <h2>{{ '@page::section.scrollable.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.scrollable.description' | trans }}</div>
    <div class="zone zone--split zone-demo--frame">
        <div class="zone zone--narrow zone--size-6 zone--scrollable zone--panel">
            <div class="zone--content">
                {{ demo.filler(30, '@page::scrollable.item' | trans) }}
            </div>
        </div>
        <div class="zone zone--scrollable zone--panel">
            <div class="zone--content">
                {{ demo.filler(30, '@page::scrollable.line' | trans) }}
            </div>
        </div>
    </div>

    <h2>{{ '@page::section.vertical.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.vertical.description' | trans }}</div>
    <div class="zone zone--split zone-demo--frame">
        <div class="zone zone--split zone--split--vertical zone--panel">
            {#- Narrow, so the header is the height of what it holds: a header that
                scrolls away with the body is a header nobody can reach. -#}
            <div class="zone zone--narrow toolbar toolbar--shaded toolbar--compact">
                <strong>zone--narrow</strong>
                <div class="toolbar--group">
                    {{ button('ph:bold/plus', '@page::vertical.action' | trans) }}
                </div>
            </div>
            <div class="zone zone--scrollable">
                <div class="zone--content">
                    {{ demo.filler(30, '@page::scrollable.line' | trans) }}
                </div>
            </div>
        </div>
    </div>

    <h2>{{ '@page::section.wrap.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.wrap.description' | trans }}</div>
    <div class="zone zone--split zone--split--wrap zone-demo--frame zone-demo--frame--short">
        <div class="zone zone--narrow zone--size-6 zone--padded zone--panel">
            <strong>zone--narrow</strong>
        </div>
        <div class="zone zone--padded zone--panel">
            <strong>zone</strong>
            <p>{{ '@page::wrap.body' | trans }}</p>
        </div>
    </div>

    {#- A region as wide as its table: the row overflows the frame and scrolls
        sideways as one, each region still scrolling down on its own. -#}
    <h2>{{ '@page::section.fit.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.fit.description' | trans }}</div>
    {%- set fit_columns = [] -%}
    {%- set fit_row = {} -%}
    {%- for i in 1..10 -%}
        {%- set fit_columns = fit_columns|merge([{ key: 'c' ~ i, label: ('@page::fit.column' | trans) ~ ' ' ~ i, align: 'right' }]) -%}
        {%- set fit_row = fit_row|merge({ ('c' ~ i): (i * 12.5) ~ ' kg' }) -%}
    {%- endfor -%}
    <div class="zone zone--split zone-demo--frame zone-demo--frame--scroll-x">
        <div class="zone zone--narrow zone--size-6 zone--scrollable zone--panel">
            <div class="zone--content">
                {{ demo.filler(30, '@page::scrollable.item' | trans) }}
            </div>
        </div>
        <div class="zone zone--fit-content zone--panel">
            <div class="zone zone--scrollable">
                <div class="zone--content">
                    <strong>zone--fit-content</strong>
                    {{ data_table(fit_columns, [fit_row, fit_row, fit_row, fit_row, fit_row, fit_row, fit_row, fit_row, fit_row, fit_row, fit_row, fit_row]) }}
                </div>
            </div>
        </div>
    </div>

    {#- A region holding a page beside a text: never narrower than a portrait
        page as tall as the row. Widen the text and the row scrolls sideways
        instead of squeezing the page. -#}
    <h2>{{ '@page::section.portrait.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.portrait.description' | trans }}</div>
    <div class="zone zone--split zone--split--floor zone-demo--frame zone-demo--frame--scroll-x">
        <div class="zone zone--panel zone--measure" style="--zone-size: 48rem">
            <div class="zone zone--scrollable">
                <div class="zone--content">
                    <strong>zone--measure</strong> (--zone-size: 48rem)
                    {{ demo.filler(12, '@page::scrollable.item' | trans) }}
                </div>
            </div>
        </div>
        <div class="zone zone--panel zone--portrait">
            {{ document_embed(path('wexample_design_system_fixtures_placeholder_pdf'), '@page::section.portrait.title' | trans, { open: true, download: true }) }}
        </div>
    </div>
{%- endblock -%}
