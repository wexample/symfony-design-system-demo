{%- extends '@WexampleSymfonyDesignSystemDemoBundle/layouts/design_system/layout.html.twig' -%}

{%- set page_show_title = true -%}

{%- block page_header -%}
    {{ parent() }}
    {#- One tab for the workspace and its two variants, reached from the tree
        standing inside them: lit for the whole family rather than going out
        as soon as one of the others is opened. -#}
    {%- set route = app.request.attributes.get('_route')|default('') -%}
    {#- The section's pages, folding when the bar runs short (page_tabs). -#}
    {{ page_tabs([
        { label: 'WexampleSymfonyDesignSystemDemoBundle.pages.design_system.generic.layout.layout.layout-generic::tab.index', route: 'wexample_design_system_generic_layout_index' },
        { label: 'WexampleSymfonyDesignSystemDemoBundle.pages.design_system.generic.layout.layout.layout-generic::tab.zones', route: 'wexample_design_system_generic_layout_zones' },
        { label: 'WexampleSymfonyDesignSystemDemoBundle.pages.design_system.generic.layout.layout.layout-generic::tab.workspace', route: 'wexample_design_system_generic_layout_workspace', active: route starts with 'wexample_design_system_generic_layout_workspace' },
        { label: 'WexampleSymfonyDesignSystemDemoBundle.pages.design_system.generic.layout.layout.layout-generic::tab.blocks', route: 'wexample_design_system_generic_layout_blocks' },
        { label: 'WexampleSymfonyDesignSystemDemoBundle.pages.design_system.generic.layout.layout.layout-generic::tab.toolbar', route: 'wexample_design_system_generic_layout_toolbar' },
        { label: 'WexampleSymfonyDesignSystemDemoBundle.pages.design_system.generic.layout.layout.layout-generic::tab.tabs', route: 'wexample_design_system_generic_layout_tabs' },
        { label: 'WexampleSymfonyDesignSystemDemoBundle.pages.design_system.generic.layout.layout.layout-generic::tab.doc', route: 'wexample_design_system_generic_layout_doc' },
    ], { back: false }) }}
{%- endblock -%}
