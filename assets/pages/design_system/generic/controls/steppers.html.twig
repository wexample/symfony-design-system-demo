{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/controls/layout/layout-controls.html.twig' -%}

{%- macro stepper(render_pass, options) -%}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/stepper', {}, options) }}
{%- endmacro -%}

{%- block page_body -%}
    {% import _self as demo %}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    {#- The same four steps throughout, the first two already walked and linked
        back to, as a tunnel lets its reader return to what they answered. -#}
    {% set steps = [
        { label: '@page::step.account' | trans, href: app_home_url() },
        { label: '@page::step.address' | trans, href: app_home_url() },
        { label: '@page::step.payment' | trans },
        { label: '@page::step.confirm' | trans }
    ] %}

    <h2>{{ '@page::section.labelled.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.labelled.description' | trans }}</div>
    <div class="block block--padded">
        {{ demo.stepper(render_pass, { steps: steps, current: 2 }) }}
    </div>

    <h2>{{ '@page::section.numbers.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.numbers.description' | trans }}</div>
    <div class="block block--padded">
        {{ demo.stepper(render_pass, { steps: [{ href: app_home_url() }, {}, {}, {}, {}], current: 1 }) }}
    </div>

    <h2>{{ '@page::section.words.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.words.description' | trans }}</div>
    <div class="block block--padded">
        {{ demo.stepper(render_pass, { steps: steps, current: 1, numbered: false }) }}
    </div>

    <h2>{{ '@page::section.ends.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.ends.description' | trans }}</div>
    <div class="block block--padded stack--vertical">
        {{ demo.stepper(render_pass, { steps: steps, current: 0 }) }}
        {{ demo.stepper(render_pass, { steps: steps, current: 3 }) }}
    </div>

    <h2>{{ '@page::section.toolbar.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.toolbar.description' | trans }}</div>
    <div class="toolbar toolbar--shaded">
        {{ demo.stepper(render_pass, { steps: steps, current: 2 }) }}
    </div>

    <h2>{{ '@page::section.vue.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.vue.description' | trans }}</div>
    <div class="block block--padded">
        {{ vue(render_pass, '@WexampleSymfonyDesignSystemBundle/components/stepper', {
            steps: [
                { label: '@page::step.account' | trans },
                { label: '@page::step.address' | trans },
                { label: '@page::step.payment' | trans },
                { label: '@page::step.confirm' | trans }
            ],
            current: 2,
            navigable: true
        }) }}
    </div>
{%- endblock -%}
