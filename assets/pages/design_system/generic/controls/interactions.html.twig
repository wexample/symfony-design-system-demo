{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/controls/layout/layout-controls.html.twig' -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    {#- Each case says what to try with the pointer and with the keyboard:
        the page is a bench to check them by hand. -#}
    <h2>{{ '@page::section.value.title' | trans }}</h2>
    <p>{{ '@page::section.value.description' | trans }}</p>
    <div class="block block--padded cluster">
        <code>a3f1c9e2-7b48-4d16-9c5a-2e8f0b6d4371</code>
        {{ copy_button({ value: 'a3f1c9e2-7b48-4d16-9c5a-2e8f0b6d4371' }) }}
        {{ copy_button({ value: 'a3f1c9e2-7b48-4d16-9c5a-2e8f0b6d4371', label: true }) }}
    </div>

    <h2>{{ '@page::section.identifier.title' | trans }}</h2>
    <p>{{ '@page::section.identifier.description' | trans }}</p>
    <div class="block block--padded cluster">
        {{ identifier('01a18bc6-6545-7a10-a0bb-11b9031e42e8', { short: true, copy: true }) }}
        {{ identifier('01a18bc5-f5a3-77c3-939e-24e1dd529072', { short: true, copy: true }) }}
        {{ identifier('01a18bc6-6545-7a10-a0bb-11b9031e42e8', { copy: true }) }}
    </div>

    <h2>{{ '@page::section.disclosure.title' | trans }}</h2>
    <p>{{ '@page::section.disclosure.description' | trans }}</p>
    <div class="block block--padded">
        {% component '@WexampleSymfonyDesignSystemBundle/components/disclosure' with { label: '@page::section.disclosure.details' | trans, count: 3 } %}
            {% slot body %}<p>{{ '@page::section.disclosure.details_body' | trans }}</p>{% endslot %}
        {% endcomponent %}
    </div>
    {#- At the foot of a block, small and muted, as a message folds its prompts. -#}
    <div class="block block--card">
        <div class="block--body">{{ '@page::section.disclosure.details_body' | trans }}</div>
        <div class="block--footer">
            {% component '@WexampleSymfonyDesignSystemBundle/components/disclosure' with { label: '@page::section.disclosure.prompts' | trans, count: 4, quiet: true } %}
                {% slot body %}{{ '@page::section.disclosure.prompts_body' | trans }}{% endslot %}
            {% endcomponent %}
        </div>
    </div>

    <h2>{{ '@page::section.target.title' | trans }}</h2>
    <p>{{ '@page::section.target.description' | trans }}</p>
    <div class="block block--padded cluster">
        <span id="interactions-address">https://example.com/invite/7f3a9c</span>
        {{ copy_button({ target: 'interactions-address', label: true }) }}
    </div>

    <h2>{{ '@page::section.code.title' | trans }}</h2>
    <p>{{ '@page::section.code.description' | trans }}</p>
    {{ include('@WexampleSymfonyDesignSystemBundle/components/code-block/code-block.html.twig', {
        lang: 'text',
        code: "9483a-8b194\n28811-eb8b3\nb44d2-eb15a\n9d935-03932",
        copy: true,
    }) }}

    <h2>{{ '@page::section.fallback.title' | trans }}</h2>
    <p>{{ '@page::section.fallback.description' | trans }}</p>
    <div class="block block--padded">
        {{ fallback('@page::fallback.question', 'JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP') }}
    </div>

    <h2>{{ '@page::section.check.title' | trans }}</h2>
    <ul>
        {#- A yml list is read item by item: `section.check.items.0`, `.1`… -#}
        {%- for index in 0..19 -%}
            {%- if trans_exists('@page::section.check.items.' ~ index) -%}
                <li>{{ ('@page::section.check.items.' ~ index) | trans }}</li>
            {%- endif -%}
        {%- endfor -%}
    </ul>
{%- endblock -%}
