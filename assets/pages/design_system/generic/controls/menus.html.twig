{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/controls/layout/layout-controls.html.twig' -%}

{%- macro render_menus(menu_items) -%}
    {{ button_menu('ph:bold/list', '@page::menu.primary' | trans, menu_items) }}
    {{ button_menu('ph:bold/dots-three-outline', '@page::menu.more' | trans, menu_items, { menu_align: 'right', items_align: 'right' }) }}
    {{ button_menu('ph:bold/moon', '@page::menu.invert' | trans, menu_items, { wrapper_class: 'button-menu--invert' }) }}
    {{ button_menu('ph:bold/caret-up', '@page::menu.options.top_left' | trans, menu_items, { menu_vertical: 'top', menu_align: 'left' }) }}
    {{ button_menu('ph:bold/caret-up', '@page::menu.options.top_right' | trans, menu_items, { menu_vertical: 'top', menu_align: 'right', items_align: 'right' }) }}
    {{ button_menu('ph:bold/list', '@page::menu.primary' | trans, menu_items, { wrapper_class: 'is-assisted' }) }}
{%- endmacro -%}

{%- block page_body -%}
    {% import _self as macros %}

    {% set menu_items = [
        { icon: 'ph:bold/clipboard-text', label: '@page::menu.item.report',   href: app_home_url() },
        { icon: 'ph:bold/gear',           label: '@page::menu.item.settings', href: app_home_url() },
        { icon: 'ph:bold/sign-out',       label: '@page::menu.item.logout',   href: app_home_url() },
        { icon: 'ph:bold/text-aa',        label: '@page::menu.item.long',     href: app_home_url() }
    ] %}

    {#- The same shape the plain items take, with one key more. A bare line parts
        two runs of items; given a word, the line names what follows it. -#}
    {% set grouped_items = [
        { icon: 'ph:bold/clipboard-text', label: '@page::menu.item.report',   href: app_home_url() },
        { icon: 'ph:bold/chart-line',     label: '@page::menu.item.stats',    href: app_home_url() },
        { separator: true },
        { icon: 'ph:bold/gear',           label: '@page::menu.item.settings', href: app_home_url() },
        { icon: 'ph:bold/user',           label: '@page::menu.item.profile',  href: app_home_url() },
        { separator: true, label: '@page::menu.group.danger' },
        { icon: 'ph:bold/trash',          label: '@page::menu.item.delete',   href: app_home_url() },
        { icon: 'ph:bold/sign-out',       label: '@page::menu.item.logout',   href: app_home_url() }
    ] %}

    <h2>{{ '@page::section.separators.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.separators.description' | trans }}</div>
    <div class="block block--padded cluster">
        {{ button_menu('ph:bold/list', '@page::menu.grouped' | trans, grouped_items) }}
        {{ button_menu('ph:bold/dots-three-vertical', null, grouped_items, { menu_align: 'right' }) }}
        {{ vue(render_pass, '@WexampleSymfonyDesignSystemBundle/components/button-menu', {
            label: '@page::menu.grouped_vue' | trans,
            items: [
                { icon: 'ph:bold/clipboard-text', label: '@page::menu.item.report'   | trans, href: '#' },
                { icon: 'ph:bold/chart-line',     label: '@page::menu.item.stats'    | trans, href: '#' },
                { separator: true },
                { icon: 'ph:bold/gear',           label: '@page::menu.item.settings' | trans, href: '#' },
                { separator: true, label: '@page::menu.group.danger' | trans },
                { icon: 'ph:bold/trash',          label: '@page::menu.item.delete'   | trans, href: '#' }
            ]
        }) }}
    </div>

    <h2>{{ '@page::section.counts.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.counts.description' | trans }}</div>
    <div class="block block--padded cluster">
        {{ button_menu('ph:bold/list', '@page::menu.counted' | trans, [
            { icon: 'ph:bold/tray',   label: '@page::menu.item.inbox',    href: app_home_url(), count: 12 },
            { icon: 'ph:bold/bell',   label: '@page::menu.item.alerts',   href: app_home_url(), count: 3 },
            { icon: 'ph:bold/gear',   label: '@page::menu.item.settings', href: app_home_url() }
        ]) }}
        {{ vue(render_pass, '@WexampleSymfonyDesignSystemBundle/components/button-menu', {
            label: '@page::menu.counted_vue' | trans,
            items: [
                { icon: 'ph:bold/tray',   label: '@page::menu.item.inbox'    | trans, href: '#', count: 12 },
                { icon: 'ph:bold/bell',   label: '@page::menu.item.alerts'   | trans, href: '#', count: 3 },
                { icon: 'ph:bold/gear',   label: '@page::menu.item.settings' | trans, href: '#' }
            ]
        }) }}
    </div>

    {#- The other menu the count serves: the vertical one a layout hangs on the
        side, whose items come from the same `menu_item_link`. -#}
    <div class="block block--padded">
        <nav class="menu menu--vertical">
            <ul class="menu--items">
                {{ menu_item_link('ph:bold/tray',  '@page::menu.item.inbox'    | trans, app_home_url(), { count: 12 }) }}
                {{ menu_item_link('ph:bold/bell',  '@page::menu.item.alerts'   | trans, app_home_url(), { count: 3 }) }}
                {{ menu_item_link('ph:bold/gear',  '@page::menu.item.settings' | trans, app_home_url()) }}
            </ul>
        </nav>
    </div>

    <h2>{{ '@page::section.menu.title' | trans }}</h2>
    <div class="cluster">{{ macros.render_menus(menu_items) }}</div>
    <div class="block block--padded cluster">{{ macros.render_menus(menu_items) }}</div>
    <div class="toolbar">{{ macros.render_menus(menu_items) }}</div>
{%- endblock -%}
