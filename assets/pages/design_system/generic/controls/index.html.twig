{%- extends '@WexampleSymfonyDesignSystemDemoBundle/pages/design_system/generic/controls/layout/layout-controls.html.twig' -%}
{%- import '@WexampleSymfonyDesignSystemDemoBundle/partials/overview.html.twig' as overview -%}

{%- macro compound(render_pass, menu_items) -%}
    {{ button('ph:bold/plus', '@page::button.primary' | trans) }}
    <select class="form--input form--input--select form--input--inline">
        <option>{{ '@page::select.option_one' | trans }}</option>
        <option>{{ '@page::select.option_two' | trans }}</option>
        <option>{{ '@page::select.option_three' | trans }}</option>
    </select>
    {{ button_menu('ph:bold/list', '@page::menu.primary' | trans, menu_items, { menu_align: 'right' }) }}
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/switch', { label: '@page::switch.label_right' }) }}
    {{ button_link('ph:bold/arrow-up-right', '@page::link.external' | trans, constant('Wexample\\Helpers\\Helper\\PlaceholderHelper::DEMO_URL'), { attr: { target: '_blank', rel: 'noopener noreferrer' } }) }}
{%- endmacro -%}

{%- block page_body -%}
    {% import _self as controls %}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    {{ overview.pages(render_pass, [
        { route: 'wexample_design_system_generic_controls_buttons', icon: 'ph:bold/rectangle', title: '@page::page.buttons.title' | trans, description: '@page::page.buttons.description' | trans },
        { route: 'wexample_design_system_generic_controls_menus', icon: 'ph:bold/list', title: '@page::page.menus.title' | trans, description: '@page::page.menus.description' | trans }
    ]) }}

    <h2>{{ '@page::section.compound.title' | trans }}</h2>
    <div class="lead">{{ '@page::section.compound.description' | trans }}</div>
    {% set menu_items = [
        { icon: 'ph:bold/clipboard-text', label: '@page::menu.item.report',   href: app_home_url() },
        { icon: 'ph:bold/gear',           label: '@page::menu.item.settings', href: app_home_url() },
        { icon: 'ph:bold/sign-out',       label: '@page::menu.item.logout',   href: app_home_url() },
        { icon: 'ph:bold/text-aa',        label: '@page::menu.item.long',     href: app_home_url() }
    ] %}
    <div class="block block--padded cluster">{{ controls.compound(render_pass, menu_items) }}</div>
    <div class="toolbar toolbar--shaded">{{ controls.compound(render_pass, menu_items) }}</div>
    <div class="toolbar toolbar--shaded toolbar--compact">{{ controls.compound(render_pass, menu_items) }}</div>
{%- endblock -%}
