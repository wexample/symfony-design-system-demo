{%- extends '@WexampleSymfonyLoaderBundle/bases/form.html.twig' -%}

{% block form_body %}
    <div class="lead">{{ '@form::description' | trans }}</div>
    {{ form_row(form.hidden_demo) }}
    <div class="grid grid--2">
        {{ form_row(form.text_simple) }}
        {{ form_row(form.password) }}
    </div>
    {{ form_row(form.text_area) }}
    {{ form_row(form.emoji) }}
    {{ form_row(form.entity_search) }}
    <div class="grid grid--3">
        {{ form_row(form.number) }}
        {{ form_row(form.email) }}
        {{ form_row(form.url) }}
    </div>
    <div class="grid grid--3">
        {{ form_row(form.date) }}
        {{ form_row(form.datetime) }}
        {{ form_row(form.time) }}
    </div>
    {{ form_row(form.file) }}
    <div class="grid grid--2">
        {{ form_row(form.radio_choice) }}
        {{ form_row(form.switch) }}
    </div>
    {{ form_widget(form.button_demo) }}
    {{ form_actions(form) }}
{% endblock %}
