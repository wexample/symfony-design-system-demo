{
  "name": "wexample/symfony-design-system-demo",
  "description": "Design system showcase pages for Symfony",
  "type": "library",
  "license": "MIT",
  "version": "11.1.4",
  "keywords": [
    "symfony-ux"
  ],
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyDesignSystemDemo\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "symfony/uid": ">=6.2",
    "wexample/php-pseudocode": ">=2.2.0",
    "wexample/symfony-api": ">=14.0.0",
    "wexample/symfony-check": ">=4.0.0",
    "wexample/symfony-coding": ">=5.0.0",
    "wexample/symfony-design-system": ">=39.0.0",
    "wexample/symfony-design-system-effects": ">=3.0.0",
    "wexample/symfony-forms": ">=14.0.0",
    "wexample/symfony-helpers": ">=18.0.0",
    "wexample/symfony-live": ">=5.7.0",
    "wexample/symfony-pseudocode": ">=4.0.0",
    "wexample/symfony-search": ">=4.2.0",
    "wexample/symfony-template": ">=2.1.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}