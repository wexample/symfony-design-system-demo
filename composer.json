{
  "name": "wexample/symfony-design-system-demo",
  "description": "Design system showcase pages for Symfony",
  "type": "library",
  "license": "MIT",
  "version": "12.0.3",
  "keywords": [
    "symfony-ux"
  ],
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyDesignSystemDemo\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "symfony/uid": ">=6.2",
    "wexample/php-pseudocode": ">=3.1.0",
    "wexample/symfony-api": ">=17.0.0",
    "wexample/symfony-check": ">=4.0.4",
    "wexample/symfony-coding": ">=6.0.0",
    "wexample/symfony-design-system": ">=43.0.0",
    "wexample/symfony-design-system-effects": ">=3.0.3",
    "wexample/symfony-forms": ">=16.0.0",
    "wexample/symfony-helpers": ">=19.1.0",
    "wexample/symfony-live": ">=5.8.0",
    "wexample/symfony-pseudocode": ">=4.0.2",
    "wexample/symfony-search": ">=6.0.0",
    "wexample/symfony-template": ">=2.1.2"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}