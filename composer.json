{
  "name": "wexample/symfony-design-system-demo",
  "description": "Design system showcase pages for Symfony",
  "type": "library",
  "license": "MIT",
  "version": "6.0.1",
  "keywords": [
    "symfony-ux"
  ],
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyDesignSystemDemo\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "symfony/uid": ">=6.2",
    "wexample/php-pseudocode": ">=1.0.0",
    "wexample/symfony-api": ">=5.0.0",
    "wexample/symfony-design-system": ">=14.0.0",
    "wexample/symfony-forms": ">=7.0.0",
    "wexample/symfony-helpers": ">=8.0.0",
    "wexample/symfony-live": ">=4.0.0",
    "wexample/symfony-pseudocode": ">=3.0.0",
    "wexample/symfony-search": ">=4.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}